// ==Moss==
// name:        mailForward
// namespace:   https://github.com/vididvidid/DailyScripts
// version:     0.1.0
// description: Forward new SnappyMail inbox mail to a personal address, on an hourly check, from your own logged-in browser session. For a company webmail that has no server-side filters.
// author:      vididvidid
// homepage:    https://github.com/vididvidid/DailyScripts/tree/main/mailForward
// match:       *://*/*
// noframes:
// run-at:      document-idle
// grant:
//   - GM_getValue
//   - GM_setValue
//   - GM_registerMenuCommand
//   - GM_notification
// ==/Moss==

/*
 * mailForward — a tiny client-side "forward rule" for SnappyMail/RainLoop webmail that
 * has no Sieve filters. It runs only on a page where SnappyMail is loaded (it checks for
 * window.rl), reuses that page's own session + CSRF token via rl.fetchJSON, and every
 * CHECK_EVERY_MS it:
 *
 *   1. asks the server for the newest INBOX messages,
 *   2. keeps only messages whose UID is greater than the last one it forwarded,
 *   3. forwards each of those to FORWARD_TO, newest-last,
 *   4. remembers the highest UID it handled, per account.
 *
 * It never touches mail that was already in the box when you first ran it (baseline), and
 * it starts in DRY_RUN so you can confirm it detects the right messages before it sends a
 * single thing.
 */

const CONFIG = {
    // Where new mail should go.
    FORWARD_TO: 'vididvidid@gmail.com',

    // Which mailbox to watch and how many recent messages to scan each tick.
    FOLDER: 'INBOX',
    SCAN_LIMIT: 20,

    // Hourly.
    CHECK_EVERY_MS: 60 * 60 * 1000,

    // true  = only log what it WOULD forward (no mail is sent). Flip to false once the
    //         console shows it detecting the right messages.
    DRY_RUN: true,

    // --- Calibration: SnappyMail JSON action names. These match stock SnappyMail 2.x.
    // If a call logs "unknown action" or an empty result, fix the name here (see the
    // capture snippet in mailForward/README notes).
    ACTION_LIST: 'MessageList',
    ACTION_MESSAGE: 'Message',
    ACTION_SEND: 'SendMessage',
};

const LOG = (...a) => console.log('%c[mailForward]', 'color:#e67e22;font-weight:bold', ...a);

/* Only run where SnappyMail actually is. */
function snappymail_ready() {
    return typeof window.rl === 'object'
        && window.rl !== null
        && typeof window.rl.fetchJSON === 'function'
        && typeof window.rl.settings === 'object';
}

/* The account we are logged in as — used to key stored state so two accounts don't mix. */
function account_email() {
    try {
        const sys = window.rl.settings.get('System') || {};
        return sys.Email || window.rl.settings.app('Email') || 'unknown';
    } catch (e) {
        return 'unknown';
    }
}

/* Build the JSON-RPC URL the same way SnappyMail's own boot code does. */
function rpc_url() {
    const base = location.pathname.replace(/\/+$/, '') + '/?/';
    const rand = Math.random().toString().slice(2);
    return base + 'Json/&q[]=/0/' + rand + '/';
}

/*
 * call(action, params) -> Promise<Result> using the page's own authenticated transport.
 * rl.fetchJSON adds the X-SM-Token header and same-origin cookies for us.
 */
async function call(action, params) {
    const body = Object.assign({ Action: action }, params || {});
    const data = await window.rl.fetchJSON(rpc_url(), {}, body);
    if (!data || data.Action !== action) {
        throw new Error('unexpected response for ' + action + ': ' + JSON.stringify(data).slice(0, 200));
    }
    if (data.Result === false || data.Result == null) {
        throw new Error('server refused ' + action + ' (ErrorCode ' + data.ErrorCode + ')');
    }
    return data.Result;
}

/* Newest INBOX messages as [{ uid, subject, from }], highest uid first. */
async function list_recent() {
    const res = await call(CONFIG.ACTION_LIST, {
        Folder: CONFIG.FOLDER,
        Offset: 0,
        Limit: CONFIG.SCAN_LIMIT,
        Search: '',
        UseThreads: 0,
    });
    const rows = res['@Collection'] || res.MessageList || res.Collection || [];
    return rows.map((m) => ({
        uid: parseInt(m.Uid, 10),
        subject: m.Subject || '(no subject)',
        from: (m.From && m.From[0] && m.From[0].Email) || '',
    })).filter((m) => Number.isFinite(m.uid));
}

/* Full text of one message, for the forwarded body. */
async function fetch_message(uid) {
    const res = await call(CONFIG.ACTION_MESSAGE, { Folder: CONFIG.FOLDER, Uid: String(uid) });
    return {
        subject: res.Subject || '(no subject)',
        fromEmail: (res.From && res.From[0] && res.From[0].Email) || '',
        fromName: (res.From && res.From[0] && res.From[0].DisplayName) || '',
        date: res.DateTimeStampInUTC ? new Date(res.DateTimeStampInUTC * 1000).toUTCString() : '',
        text: res.Plain || strip_html(res.Html || ''),
    };
}

function strip_html(html) {
    const d = document.createElement('div');
    d.innerHTML = html;
    return (d.textContent || '').trim();
}

/*
 * Forward one message as a new plain-text mail to FORWARD_TO.
 *
 * NOTE: this is the one call that needs confirming against your server. The field set
 * below is the stock SnappyMail SendMessage shape; if sending errors, capture a real
 * forward from the webmail (see README notes) and adjust these keys.
 */
async function forward(msg) {
    const header =
        '---------- Forwarded message ----------\n' +
        'From: ' + (msg.fromName ? msg.fromName + ' <' + msg.fromEmail + '>' : msg.fromEmail) + '\n' +
        'Date: ' + msg.date + '\n' +
        'Subject: ' + msg.subject + '\n\n';

    return call(CONFIG.ACTION_SEND, {
        IdentityID: '',
        MessageFolder: '',
        MessageUid: '',
        SaveFolder: '',
        From: account_email(),
        To: CONFIG.FORWARD_TO,
        Cc: '',
        Bcc: '',
        ReplyTo: '',
        Subject: 'Fwd: ' + msg.subject,
        Text: header + msg.text,
        Html: '',
        Attachments: {},
        Dsn: 0,
        ReadReceiptRequest: 0,
    });
}

/* --- state, keyed per account --- */
function key() { return 'mf_lastuid::' + account_email(); }
async function get_last_uid() { return parseInt(await GM_getValue(key(), '0'), 10) || 0; }
async function set_last_uid(uid) { await GM_setValue(key(), String(uid)); }

/* One pass. */
async function tick() {
    if (!snappymail_ready()) { return; }
    let recent;
    try {
        recent = await list_recent();
    } catch (e) {
        LOG('could not list mail:', e.message);
        return;
    }
    if (recent.length === 0) { LOG('inbox empty / nothing returned'); return; }

    const lastUid = await get_last_uid();

    // First ever run on this account: set the baseline, don't forward the backlog.
    if (lastUid === 0) {
        const maxUid = Math.max(...recent.map((m) => m.uid));
        await set_last_uid(maxUid);
        LOG('baseline set at uid', maxUid, '— only mail newer than this will be forwarded.');
        return;
    }

    const fresh = recent.filter((m) => m.uid > lastUid).sort((a, b) => a.uid - b.uid);
    if (fresh.length === 0) { LOG('no new mail'); return; }

    LOG((CONFIG.DRY_RUN ? '[DRY RUN] would forward ' : 'forwarding ') + fresh.length + ' message(s):');
    for (const m of fresh) {
        LOG('  uid', m.uid, '·', m.from, '·', m.subject);
        if (CONFIG.DRY_RUN) { await set_last_uid(m.uid); continue; }
        try {
            const full = await fetch_message(m.uid);
            await forward(full);
            await set_last_uid(m.uid);
            LOG('  -> forwarded to', CONFIG.FORWARD_TO);
        } catch (e) {
            LOG('  -> FAILED on uid', m.uid, ':', e.message, '(stopping this pass)');
            break; // leave last_uid before this one so it retries next hour, no skips
        }
    }
    if (!CONFIG.DRY_RUN) {
        try { GM_notification({ title: 'mailForward', text: 'Forwarded ' + fresh.length + ' message(s)' }); } catch (e) {}
    }
}

function start() {
    if (!snappymail_ready()) { return; } // not a SnappyMail page
    LOG('active on', account_email(), '· mode:', CONFIG.DRY_RUN ? 'DRY RUN' : 'LIVE', '· every', CONFIG.CHECK_EVERY_MS / 60000, 'min');
    try {
        GM_registerMenuCommand('mailForward: check now', () => tick());
        GM_registerMenuCommand('mailForward: reset baseline', async () => { await set_last_uid(0); LOG('baseline cleared; next check re-baselines.'); });
    } catch (e) {}
    setTimeout(tick, 8000);            // once shortly after load
    setInterval(tick, CONFIG.CHECK_EVERY_MS); // then hourly
}

start();
