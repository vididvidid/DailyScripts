// ==Moss==
// name:        mailForward
// namespace:   https://github.com/vididvidid/DailyScripts
// version:     1.0.0
// description: Forwards new SnappyMail inbox mail to a personal address using only the session already logged in to that tab. For a company webmail with no server-side filters. Does nothing at all when you are not logged in.
// author:      vididvidid
// homepage:    https://github.com/vididvidid/DailyScripts/tree/main/mailForward
// match:       https://mail.sthithaquantum.com/*
// noframes:
// run-at:      document-idle
// grant:
//   - GM_getValue
//   - GM_setValue
//   - GM_registerMenuCommand
// ==/Moss==

'use strict';

/*
 * mailForward — a client-side "forward rule" for a SnappyMail webmail that has no Sieve
 * filters.
 *
 * It never has credentials of its own. Every request goes through the page's own
 * `rl.fetchJSON`, which carries the session cookies and the X-SM-Token of the tab you
 * are already logged in to. When that session is gone, the script makes no request at
 * all: `logged_in()` is checked before every call, and AppData's `Auth` flag is the
 * gate.
 *
 * Each pass:
 *   1. MessageList the newest INBOX messages,
 *   2. keep the ones whose UID is above the last one handled,
 *   3. Message-fetch each and send it on to CONFIG.forward_to as a new mail,
 *   4. store the highest UID handled, per account.
 *
 * The API shapes below are from SnappyMail v2.38.2 (the version this server runs):
 *   POST  /?/Json/&q[]=/0/                        { Action: 'MessageList', folder, limit, ... }
 *   GET   /?/Json/&q[]=/0/Message/&q[]=/<b64>     b64 of [folder, uid, threads, accountHash]
 *   POST  /?/Json/&q[]=/0/                        { Action: 'SendMessage', to, subject, plain, ... }
 * Action parameters are camelCase, and the body of a message is `plain` / `html`.
 */

const CONFIG = {
    // Where new mail is sent on to.
    forward_to: 'vididvidid@gmail.com',

    // Who the forward is sent as. This server does not put Identities in AppData, so
    // it is set here rather than detected. Must be an address this account may send as.
    send_as: '"Yash Kumar Kasaudhan" <yash@sthithaquantum.com>',

    // Mailbox to watch, and how many recent messages to look at each pass.
    folder: 'INBOX',
    scan_limit: 20,

    // How often to check. Note: this account auto-logs-out after 30 minutes, so an
    // hourly timer will often wake to a dead session and (correctly) do nothing. The
    // focus check below is what makes it fire in practice, whenever you come back to
    // the tab. Lower this to 10 * 60 * 1000 if you want it to keep up on its own.
    check_every_ms: 60 * 60 * 1000,

    // Re-check when the tab is focused, at most this often.
    focus_min_gap_ms: 5 * 60 * 1000,

    // Wait this long after load before the first pass, so the app finishes booting.
    first_pass_delay_ms: 8000,

    // true = log what it WOULD forward and send nothing. Flip to false once the console
    // shows it picking up the right messages.
    dry_run: true,

    // Folder to file a copy of each forward in; '' keeps Sent clean.
    save_folder: ''
};

const LOG_STYLE = 'color:#e67e22;font-weight:bold';

let last_run_at = 0;

/*
 * log(...parts) -> writes one tagged console line
 */
function log() {
    const parts = ['%c[mailForward]', LOG_STYLE];
    for (let i = 0; i < arguments.length; i++) {
        parts.push(arguments[i]);
    }
    console.log.apply(console, parts);
}

/*
 * app_ready() -> true when SnappyMail's own transport is on the page
 */
function app_ready() {
    if (typeof window.rl !== 'object' || window.rl === null) {
        return false;
    }
    if (typeof window.rl.fetchJSON !== 'function') {
        return false;
    }
    return typeof window.rl.settings === 'object' && window.rl.settings !== null;
}

/*
 * settings_get(key) -> a value from the AppData the server sent this tab, or null
 */
function settings_get(key) {
    try {
        const value = window.rl.settings.get(key);
        return value === undefined ? null : value;
    } catch (e) {
        return null;
    }
}

/*
 * logged_in() -> true only while this tab holds a live, authenticated session.
 * Checked before every request: when it is false the script touches nothing.
 */
function logged_in() {
    if (!app_ready()) {
        return false;
    }
    if (settings_get('Auth') !== true) {
        return false;
    }
    return account_hash().length > 0;
}

/*
 * account_hash() -> the server's hash for the signed-in account, '' when absent.
 * It identifies the account in Message raw keys and in stored state.
 */
function account_hash() {
    const hash = settings_get('accountHash');
    return typeof hash === 'string' ? hash : '';
}

/*
 * pick(object, names, fallback) -> the first present, non-empty property in names
 */
function pick(object, names, fallback) {
    if (typeof object !== 'object' || object === null) {
        return fallback;
    }
    for (let i = 0; i < names.length; i++) {
        const value = object[names[i]];
        if (value !== undefined && value !== null && value !== '') {
            return value;
        }
    }
    return fallback;
}

/*
 * sender() -> the From value to send as, or '' when it cannot be determined
 *
 * CONFIG.send_as wins. Only when that is blank does it try AppData, which on this
 * server carries no Identities list, so the config value is the normal path.
 */
function sender() {
    if (CONFIG.send_as !== '') {
        return CONFIG.send_as;
    }
    const identities = settings_get('Identities');
    if (Array.isArray(identities) && identities.length > 0) {
        const email = pick(identities[0], ['email', 'Email'], '');
        const name = pick(identities[0], ['name', 'Name'], '');
        if (email !== '') {
            return name === '' ? email : '"' + name + '" <' + email + '>';
        }
    }
    const system_email = pick(settings_get('System') || {}, ['Email', 'email'], '');
    return typeof system_email === 'string' ? system_email : '';
}

/*
 * base_url() -> "https://host/?/" for this install
 */
function base_url() {
    return location.origin + location.pathname.replace(/\/+$/, '') + '/?/';
}

/*
 * b64_url(text) -> URL-safe base64 of text, unpadded, as SnappyMail encodes raw keys
 */
function b64_url(text) {
    const bytes = new TextEncoder().encode(text);
    let binary = '';
    for (let i = 0; i < bytes.length; i++) {
        binary += String.fromCharCode(bytes[i]);
    }
    return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=+$/, '');
}

/*
 * unwrap(action, data) -> data.Result, or throws with what the server said instead
 */
function unwrap(action, data) {
    if (typeof data !== 'object' || data === null) {
        throw new Error(action + ': no response');
    }
    if (data.Result === undefined || data.Result === null || data.Result === false) {
        throw new Error(action + ': refused (ErrorCode ' + data.ErrorCode + ')');
    }
    return data.Result;
}

/*
 * rpc_post(action, params) -> Promise<Result> for an action that takes a JSON body
 */
async function rpc_post(action, params) {
    if (!logged_in()) {
        throw new Error('not signed in');
    }
    const body = { Action: action };
    const keys = Object.keys(params);
    for (let i = 0; i < keys.length; i++) {
        body[keys[i]] = params[keys[i]];
    }
    const data = await window.rl.fetchJSON(base_url() + 'Json/&q[]=/0/', {}, body);
    return unwrap(action, data);
}

/*
 * list_recent() -> Promise<struct row[]> newest INBOX messages
 *
 * struct row { uid: number; subject: string; from: string; }
 */
async function list_recent() {
    const result = await rpc_post('MessageList', {
        folder: CONFIG.folder,
        offset: 0,
        limit: CONFIG.scan_limit,
        search: '',
        sort: '',
        uidNext: 0,
        useThreads: 0
    });
    const collection = pick(result, ['@Collection', 'Collection', 'MessageList'], []);
    const rows = [];
    if (!Array.isArray(collection)) {
        return rows;
    }
    for (let i = 0; i < collection.length; i++) {
        const item = collection[i];
        const uid = parseInt(pick(item, ['uid', 'Uid'], '0'), 10);
        if (Number.isFinite(uid) && uid > 0) {
            rows.push({
                uid: uid,
                subject: pick(item, ['subject', 'Subject'], '(no subject)'),
                from: sender_of(item)
            });
        }
    }
    return rows;
}

/*
 * sender_of(item) -> "name <email>" for a list row or message, '' when absent
 */
function sender_of(item) {
    const from = pick(item, ['from', 'From'], null);
    let first = null;
    if (Array.isArray(from) && from.length > 0) {
        first = from[0];
    } else if (typeof from === 'object' && from !== null) {
        const collection = pick(from, ['@Collection', 'Collection'], null);
        if (Array.isArray(collection) && collection.length > 0) {
            first = collection[0];
        }
    }
    if (first === null) {
        return '';
    }
    const email = pick(first, ['email', 'Email'], '');
    const name = pick(first, ['name', 'DisplayName', 'Name'], '');
    return name === '' ? email : name + ' <' + email + '>';
}

/*
 * fetch_message(uid) -> Promise<struct mail> the full message behind a list row
 *
 * struct mail { uid: number; subject, from, date, plain: string; }
 */
async function fetch_message(uid) {
    if (!logged_in()) {
        throw new Error('not signed in');
    }
    const raw = b64_url(JSON.stringify([CONFIG.folder, uid, 0, account_hash()]));
    const url = base_url() + 'Json/&q[]=/0/Message/&q[]=/' + raw;
    const data = await window.rl.fetchJSON(url);
    const result = unwrap('Message', data);
    const stamp = parseInt(pick(result, ['dateTimestamp', 'DateTimeStampInUTC'], '0'), 10);
    let plain = pick(result, ['plain', 'Plain'], '');
    if (plain === '') {
        plain = html_to_text(pick(result, ['html', 'Html'], ''));
    }
    return {
        uid: uid,
        subject: pick(result, ['subject', 'Subject'], '(no subject)'),
        from: sender_of(result),
        date: Number.isFinite(stamp) && stamp > 0 ? new Date(stamp * 1000).toUTCString() : '',
        plain: plain
    };
}

/*
 * html_to_text(html) -> the readable text inside an HTML body
 */
function html_to_text(html) {
    const box = document.createElement('div');
    box.innerHTML = html;
    const text = box.textContent;
    return typeof text === 'string' ? text.trim() : '';
}

/*
 * forward_message(mail) -> Promise sending mail on to CONFIG.forward_to
 *
 * Sent as a fresh plain-text message quoting the original, not a MIME forward, so
 * attachments stay behind in the company inbox and are not copied out.
 */
async function forward_message(mail) {
    const from = sender();
    if (from === '') {
        throw new Error('no send_as address set in CONFIG');
    }
    const header = '---------- Forwarded message ----------\n'
        + 'From: ' + mail.from + '\n'
        + 'Date: ' + mail.date + '\n'
        + 'Subject: ' + mail.subject + '\n\n';
    return rpc_post('SendMessage', {
        identityID: '',
        messageFolder: '',
        messageUid: 0,
        saveFolder: CONFIG.save_folder,
        draftInfo: null,
        from: from,
        to: CONFIG.forward_to,
        cc: '',
        bcc: '',
        replyTo: '',
        subject: 'Fwd: ' + mail.subject,
        plain: header + mail.plain,
        html: '',
        inReplyTo: '',
        references: '',
        attachments: null,
        dsn: 0,
        requireTLS: 0,
        readReceiptRequest: 0,
        markAsImportant: 0
    });
}

/*
 * state_key() -> the storage key holding the last handled UID for this account
 */
function state_key() {
    return 'mailforward.last_uid.' + account_hash();
}

/*
 * get_last_uid() -> Promise<number> last UID handled, 0 when this account is new here
 */
async function get_last_uid() {
    const stored = parseInt(await GM_getValue(state_key(), '0'), 10);
    return Number.isFinite(stored) ? stored : 0;
}

/*
 * set_last_uid(uid) -> Promise storing uid as handled
 */
async function set_last_uid(uid) {
    await GM_setValue(state_key(), String(uid));
}

/*
 * newer_than(rows, uid) -> rows above uid, oldest first
 */
function newer_than(rows, uid) {
    const fresh = [];
    for (let i = 0; i < rows.length; i++) {
        if (rows[i].uid > uid) {
            fresh.push(rows[i]);
        }
    }
    fresh.sort(function (a, b) {
        return a.uid - b.uid;
    });
    return fresh;
}

/*
 * highest_uid(rows) -> the largest uid in rows, 0 when empty
 */
function highest_uid(rows) {
    let top = 0;
    for (let i = 0; i < rows.length; i++) {
        if (rows[i].uid > top) {
            top = rows[i].uid;
        }
    }
    return top;
}

/*
 * tick() -> Promise, one pass. Returns straight away unless a live session is present.
 */
async function tick() {
    if (!logged_in()) {
        log('not signed in — nothing done');
        return;
    }
    last_run_at = Date.now();

    let rows;
    try {
        rows = await list_recent();
    } catch (e) {
        log('could not read the inbox:', e.message);
        return;
    }
    if (rows.length === 0) {
        log('inbox returned nothing');
        return;
    }

    const last_uid = await get_last_uid();

    // First pass for this account: remember where we came in, forward no backlog.
    if (last_uid === 0) {
        const top = highest_uid(rows);
        await set_last_uid(top);
        log('starting point set at uid', top, '— only mail after this is forwarded');
        return;
    }

    const fresh = newer_than(rows, last_uid);
    if (fresh.length === 0) {
        log('no new mail');
        return;
    }

    log((CONFIG.dry_run ? 'dry run, would forward ' : 'forwarding ') + fresh.length + ' message(s)');
    for (let i = 0; i < fresh.length; i++) {
        const row = fresh[i];
        log('  uid', row.uid, '·', row.from, '·', row.subject);
        if (CONFIG.dry_run) {
            await set_last_uid(row.uid);
            continue;
        }
        if (!logged_in()) {
            log('  session ended mid-pass — stopping, will resume next check');
            return;
        }
        try {
            const mail = await fetch_message(row.uid);
            await forward_message(mail);
            await set_last_uid(row.uid);
            log('  sent to', CONFIG.forward_to);
        } catch (e) {
            // Leave last_uid below this one so the next pass retries it instead of skipping.
            log('  failed on uid', row.uid + ':', e.message, '— stopping this pass');
            return;
        }
    }
}

/*
 * on_focus() -> runs a pass when the tab is focused and the last one was a while ago
 */
function on_focus() {
    if (document.visibilityState !== 'visible') {
        return;
    }
    if (Date.now() - last_run_at < CONFIG.focus_min_gap_ms) {
        return;
    }
    tick();
}

/*
 * start() -> wires the timers and menu commands, once SnappyMail is on the page
 */
function start() {
    if (!app_ready()) {
        return;
    }
    log('loaded ·', CONFIG.dry_run ? 'DRY RUN' : 'LIVE', '· every',
        Math.round(CONFIG.check_every_ms / 60000), 'min · from',
        sender() === '' ? '(NOT SET)' : sender(), '· to', CONFIG.forward_to);
    if (!logged_in()) {
        log('no session in this tab yet — it will start once you are signed in');
    }
    try {
        GM_registerMenuCommand('mailForward: check now', function () {
            tick();
        });
        GM_registerMenuCommand('mailForward: forget starting point', async function () {
            await set_last_uid(0);
            log('starting point cleared — the next check sets a new one');
        });
    } catch (e) {
        log('menu commands unavailable:', e.message);
    }
    setTimeout(tick, CONFIG.first_pass_delay_ms);
    setInterval(tick, CONFIG.check_every_ms);
    document.addEventListener('visibilitychange', on_focus);
}

start();
