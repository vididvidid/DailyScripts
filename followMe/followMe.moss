// ==Moss==
// name:        followMe
// namespace:   https://github.com/vididvidid/DailyScripts
// version:     0.4.0
// description: Tap-by-pixel automation for any website: mark points on the page, chain clicks with pauses and "page loaded" / "URL changed" / "internet is on" checks, play them as desktop, mobile or tablet, hand off to another site in split view, and replay them. No selectors, no Puppeteer.
// author:      vididvidid
// homepage:    https://github.com/vididvidid/DailyScripts/tree/main/followMe
// match:       *://*/*
// noframes:
// run-at:      document-idle
// use:         moss/ui/toast as toast
// grant:
//   - GM_xmlhttpRequest
//   - GM_device
//   - GM_split
// connect:
// # the internet check asks this page
//   - www.gstatic.com
// # gist sync
//   - api.github.com
//   - gist.githubusercontent.com
// ==/Moss==

// Built by tools/build.mjs from src/ — edit those files, not this one.

// ---------- src/core/util.js ----------

/*
 * Small helpers every other file uses. followMe is built by concatenating src/ in the
 * order tools/build.mjs lists, like linking C translation units: each file declares
 * plain functions and constants, and later files call earlier ones.
 */

const FM_PREFIX = 'fm';   // ids, CSS classes and storage keys start with this

let id_counter = 0;

/*
 * new_id(kind) -> a fresh id such as "fm-step-l2k9x-3"
 */
function new_id(kind) {
    id_counter++;
    return `${FM_PREFIX}-${kind}-${Date.now().toString(36)}-${id_counter}`;
}

/*
 * clone(value) -> a deep copy of plain JSON data
 */
function clone(value) {
    return JSON.parse(JSON.stringify(value));
}

/*
 * clamp(n, lo, hi) -> n kept between lo and hi
 */
function clamp(n, lo, hi) {
    return Math.min(hi, Math.max(lo, n));
}

/*
 * to_number(value, fallback) -> value as a finite number, or fallback
 */
function to_number(value, fallback) {
    const n = Number(value);
    return Number.isFinite(n) ? n : fallback;
}

/*
 * site_of(url) -> "https://example.com" for any URL on that site
 */
function site_of(url) {
    try {
        return new URL(url).origin;
    } catch (e) {
        return '';
    }
}

/*
 * pause(ms) -> Promise resolved after ms
 */
function pause(ms) {
    return new Promise(function (resolve) {
        setTimeout(resolve, Math.max(0, ms));
    });
}

/*
 * sleep(run, ms, on_tick) -> Promise<boolean>: waits ms in short slices so a stopped
 * run wakes at once; false when the run was stopped. on_tick(left_ms) reports progress.
 */
async function sleep(run, ms, on_tick) {
    const end = Date.now() + Math.max(0, ms);
    while (Date.now() < end) {
        if (run !== null && run.stopped) {
            return false;
        }
        if (on_tick) {
            on_tick(end - Date.now());
        }
        await pause(Math.min(100, end - Date.now()));
    }
    return run === null || !run.stopped;
}

/*
 * with_jitter(ms, jitter) -> ms moved up or down by a random amount up to jitter
 */
function with_jitter(ms, jitter) {
    if (!jitter) {
        return ms;
    }
    return Math.max(0, Math.round(ms + (Math.random() * 2 - 1) * jitter));
}

/*
 * format_ms(ms) -> "800 ms", "2.5 s", "1 min 30 s"
 */
function format_ms(ms) {
    if (ms < 1000) {
        return `${Math.round(ms)} ms`;
    }
    if (ms < 60000) {
        return `${Math.round(ms / 100) / 10} s`;
    }
    const min = Math.floor(ms / 60000);
    const sec = Math.round((ms % 60000) / 1000);
    return sec === 0 ? `${min} min` : `${min} min ${sec} s`;
}

/*
 * glob_test(pattern, text) -> true if text matches a "*" glob or a /regex/
 */
function glob_test(pattern, text) {
    const re = /^\/(.+)\/([a-z]*)$/.exec(pattern);
    try {
        if (re !== null) {
            return new RegExp(re[1], re[2].replace('g', '')).test(text);
        }
        const parts = pattern.split('*');
        for (let i = 0; i < parts.length; i++) {
            parts[i] = parts[i].replace(/[.+?^${}()|[\]\\/]/g, '\\$&');
        }
        return new RegExp(`^${parts.join('.*')}$`).test(text);
    } catch (e) {
        return false;
    }
}

/*
 * regex_of(pattern) -> RegExp for "/source/flags" or a bare source; throws if invalid
 */
function regex_of(pattern) {
    const re = /^\/(.+)\/([a-z]*)$/.exec(pattern);
    if (re !== null) {
        return new RegExp(re[1], re[2].replace('g', ''));
    }
    return new RegExp(pattern);
}

// ---------- src/core/steps.js ----------

/*
 * The data followMe stores: activities made of steps, and the checks attached to them.
 *
 * struct activity {
 *     id, name: string;
 *     site: string;            origin it was made on, "https://example.com"
 *     pages: string;           where it may run: a "*" glob or /regex/ over the URL
 *     start_url: string;       page it was made on; another activity's "other site" step opens it
 *     loops: number;           how many times to play it; 0 = until stopped
 *     loop_pause_ms: number;   pause between two loops
 *     device: 'desktop' | 'mobile' | 'tablet';   how the tab is shown while it plays
 *     orientation: 'portrait' | 'landscape';     for mobile and tablet
 *     need_online: boolean;    only play while the internet is on
 *     offline: 'wait' | 'stop';   what to do when it is off
 *     unsaved: string[];       ids of steps changed since the last Save ('' = the activity's
 *                              own settings); kept here only, not in the gist
 *     steps: struct step[];
 *     created_at, updated_at: number;
 * }
 *
 * struct step {
 *     id: string;
 *     label: string;           optional name ("Open menu"); empty = "Click 3"
 *     action: 'click' | 'double_click' | 'right_click' | 'long_press' | 'type' | 'key' | 'scroll' | 'read' | 'side' | 'wait';
 *     x, y: number;            where it was marked, in CSS pixels of the visible page
 *     place: 'element' | 'screen' | 'page' | 'scaled';   how x, y follow layout changes,
 *                              scrolling and resizing ('element': see anchor.js)
 *     anchor: struct anchor | null;   'element': the element under the point
 *     scroll_x, scroll_y: number;   page scroll when it was marked ('page')
 *     view_w, view_h: number;       window size when it was marked ('scaled')
 *     text: string;            'type': what to type; {name} puts in a value read earlier
 *     clear_first: boolean;    'type': empty the field first
 *     type_into: 'point' | 'focused';   'type': click the field at x, y first, or type into
 *                              the field that has the focus (a click step before put it there)
 *     type_mode: 'keys' | 'paste';   'type': one key at a time, or all at once
 *     key_delay_ms: number;    'type' key by key: pause between two keys
 *     enter_after: boolean;    'type': press Enter when done (submits a search box)
 *     key: string;             'key': "Enter", "Escape", "Tab", "a", …
 *     scroll_dx, scroll_dy: number;   'scroll': how far
 *     hold_ms: number;         'long_press': how long the button stays down
 *     var_name: string;        'read': the value's name, used later as {name}
 *     read_pattern: string;    'read': optional /regex/ (its first group) to keep part of the text
 *     side_activity: string;   'side': id of the activity to play on the other site
 *     side_url: string;        'side': page to open; '' = where that activity was made
 *     side_how: 'auto' | 'split' | 'window';   'side': Chrome split view or a second window
 *     side_place: 'right' | 'left';
 *     side_timeout_ms: number; 'side': give up after this long
 *     side_close: boolean;     'side': close it when it is done
 *     repeat: number;          do the action this many times
 *     repeat_pause_ms: number; pause between repeats
 *     before: struct check[];  waited for before the action
 *     after: struct check[];   waited for after the action
 *     pause_ms: number;        the break after the step, before the next one
 *     jitter_ms: number;       random ± on every pause, so timing isn't robotic
 *     enabled: boolean;        skipped when false
 * }
 *
 * struct check {
 *     kind: 'loaded' | 'url_changed' | 'url_matches' | 'online' | 'wait';
 *     value: string;           'url_matches': glob or /regex/; 'wait': ms
 *     timeout_ms: number;      give up after this long
 *     on_timeout: 'stop' | 'continue';
 * }
 *
 * Values: a 'read' step keeps what it read under its var_name for the rest of the run;
 * an 'other site' step hands the run's values to the activity it plays there and gets
 * back everything that activity read. {name} in a 'type' text or a URL is replaced by
 * the value.
 */

const ACTIONS = {
    click: { label: 'Left click', point: true },
    double_click: { label: 'Double click', point: true },
    right_click: { label: 'Right click', point: true },
    long_press: { label: 'Long press', point: true },
    type: { label: 'Type text', point: true },
    key: { label: 'Press a key', point: false },
    scroll: { label: 'Scroll', point: true },
    read: { label: 'Read text', point: true },
    side: { label: 'Run on another site', point: false },
    wait: { label: 'Only wait', point: false },
};

const CHECKS = {
    loaded: { label: 'Page fully loaded', value: false },
    url_changed: { label: 'URL changed', value: false },
    url_matches: { label: 'URL matches…', value: true },
    online: { label: 'Internet is on', value: false },
    wait: { label: 'Wait a fixed time', value: true },
};

const PLACES = {
    element: 'Follows the element there (moves with the layout)',
    screen: 'Same spot on the screen',
    page: 'Same spot on the page (follows scrolling)',
    scaled: 'Same spot relative to the window size',
};

const TYPE_INTO = { focused: 'the field that has the focus (click it in the step before)', point: 'the field at a point (clicks it first)' };
const TYPE_MODES = { keys: 'key by key', paste: 'all at once' };

const SIDE_HOWS = { auto: 'split view (or a window)', split: 'split view only', window: 'a window beside this one' };

const DEFAULT_TIMEOUT = 30000;

// Fields added after 0.1.0, filled in on activities and steps stored before.
const ACTIVITY_DEFAULTS = { start_url: '', device: 'desktop', orientation: 'portrait', need_online: true, offline: 'wait', unsaved: [] };
const STEP_DEFAULTS = {
    type_into: 'point', type_mode: 'paste', key_delay_ms: 60, enter_after: false, anchor: null,
    var_name: 'answer', read_pattern: '', side_activity: '', side_url: '', side_how: 'auto', side_place: 'right',
    side_timeout_ms: 120000, side_close: true,
};

/*
 * activity_create(name, url) -> a new, empty struct activity for the page at url
 */
function activity_create(name, url) {
    const site = site_of(url);
    return {
        id: new_id('act'),
        name: name,
        site: site,
        pages: `${site}/*`,
        start_url: url,
        loops: 1,
        loop_pause_ms: 1000,
        device: 'desktop',
        orientation: 'portrait',
        need_online: true,
        offline: 'wait',
        steps: [],
        created_at: Date.now(),
        updated_at: Date.now(),
    };
}

/*
 * step_create(x, y, view) -> a left click at (x, y); view: { scroll_x, scroll_y, w, h }
 */
function step_create(x, y, view) {
    return {
        id: new_id('step'),
        label: '',
        action: 'click',
        x: Math.round(x),
        y: Math.round(y),
        place: 'element',
        anchor: null,
        scroll_x: Math.round(view.scroll_x),
        scroll_y: Math.round(view.scroll_y),
        view_w: Math.round(view.w),
        view_h: Math.round(view.h),
        text: '',
        clear_first: true,
        type_into: 'point',
        type_mode: 'keys',
        key_delay_ms: 60,
        enter_after: false,
        key: 'Enter',
        scroll_dx: 0,
        scroll_dy: 400,
        hold_ms: 800,
        var_name: 'answer',
        read_pattern: '',
        side_activity: '',
        side_url: '',
        side_how: 'auto',
        side_place: 'right',
        side_timeout_ms: 120000,
        side_close: true,
        repeat: 1,
        repeat_pause_ms: 300,
        before: [],
        after: [],
        pause_ms: 1000,
        jitter_ms: 0,
        enabled: true,
    };
}

/*
 * step_has_point(step) -> true if the step acts at its x, y (and gets a mark on the page)
 */
function step_has_point(step) {
    if (step.action === 'type') {
        return step.type_into !== 'focused';
    }
    return ACTIONS[step.action].point;
}

/*
 * activity_fix(activity) -> the same activity with fields newer versions added filled in
 */
function activity_fix(activity) {
    const a = Object.assign({}, ACTIVITY_DEFAULTS, activity);
    if (a.start_url === '') {
        a.start_url = `${a.site}/`;
    }
    const steps = [];
    for (const step of a.steps || []) {
        steps.push(Object.assign({}, STEP_DEFAULTS, step));
    }
    a.steps = steps;
    return a;
}

/*
 * fill_vars(text, vars) -> text with every {name} of a known value replaced by it
 */
function fill_vars(text, vars) {
    return String(text).replace(/\{([A-Za-z_][\w-]*)\}/g, function (all, name) {
        return vars !== null && vars !== undefined && Object.prototype.hasOwnProperty.call(vars, name) ? String(vars[name]) : all;
    });
}

/*
 * check_create(kind) -> a struct check with sensible defaults
 */
function check_create(kind) {
    let value = '';
    if (kind === 'wait') {
        value = '1000';
    } else if (kind === 'url_matches') {
        value = '*/done*';
    }
    return { kind: kind, value: value, timeout_ms: DEFAULT_TIMEOUT, on_timeout: 'stop' };
}

/*
 * step_title(step, index) -> "Click 3" or the step's own label
 */
function step_title(step, index) {
    if (step.label) {
        return step.label;
    }
    const words = { wait: 'Wait', type: 'Type', key: 'Key', scroll: 'Scroll', read: 'Read', side: 'Other site' };
    const word = words[step.action] === undefined ? 'Click' : words[step.action];
    return `${word} ${index + 1}`;
}

/*
 * step_point(step, view) -> { x, y } where the step acts now, in viewport pixels;
 *   view: { scroll_x, scroll_y, w, h } of the page as it is now
 */
function step_point(step, view) {
    if (step.place === 'page') {
        return { x: step.x + step.scroll_x - view.scroll_x, y: step.y + step.scroll_y - view.scroll_y };
    }
    if (step.place === 'scaled' && step.view_w > 0 && step.view_h > 0) {
        return { x: Math.round(step.x * view.w / step.view_w), y: Math.round(step.y * view.h / step.view_h) };
    }
    return { x: step.x, y: step.y };
}

/*
 * describe_check(check) -> "the page is fully loaded (up to 30 s)"
 */
function describe_check(check) {
    const limit = `up to ${format_ms(check.timeout_ms)}, then ${check.on_timeout === 'stop' ? 'stop' : 'go on'}`;
    switch (check.kind) {
    case 'loaded':
        return `the page has fully loaded (${limit})`;
    case 'url_changed':
        return `the URL has changed (${limit})`;
    case 'url_matches':
        return `the URL matches ${check.value} (${limit})`;
    case 'online':
        return `the internet is on (${limit})`;
    case 'wait':
        return `${format_ms(to_number(check.value, 0))} have passed`;
    default:
        return check.kind;
    }
}

/*
 * describe_action(step) -> "left click at (412, 230)"
 */
function describe_action(step) {
    const at = `at (${step.x}, ${step.y})`;
    switch (step.action) {
    case 'click':
        return `left click ${at}`;
    case 'double_click':
        return `double click ${at}`;
    case 'right_click':
        return `right click ${at}`;
    case 'long_press':
        return `press and hold ${format_ms(step.hold_ms)} ${at}`;
    case 'type':
        return `type "${step.text}"${step.type_into === 'focused' ? ' into the focused field' : ` into the field ${at}`}${step.enter_after ? ', then Enter' : ''}`;
    case 'key':
        return `press ${step.key}`;
    case 'read':
        return `read the text ${at} as {${step.var_name}}`;
    case 'side':
        return `open ${side_target(step)} beside this page and play "${side_name(step)}" there`;
    case 'scroll':
        return `scroll ${step.scroll_dy >= 0 ? 'down' : 'up'} ${Math.abs(step.scroll_dy)} px${step.scroll_dx !== 0 ? `, ${step.scroll_dx >= 0 ? 'right' : 'left'} ${Math.abs(step.scroll_dx)} px` : ''} ${at}`;
    default:
        return 'do nothing, only wait';
    }
}

/*
 * describe_how(step) -> how the step is carried out, in plain words
 */
function describe_how(step) {
    switch (step.action) {
    case 'click':
    case 'double_click':
    case 'right_click':
        return 'Finds whatever is drawn at that pixel and sends it the same pointer and mouse events a real click makes (move, down, up, click), with the button and count of this action.';
    case 'long_press':
        return 'Presses the left button on whatever is at that pixel, keeps it down for the hold time, then releases it.';
    case 'type':
        return `${step.type_into === 'focused' ? 'Takes the field that has the focus (the one the step before clicked)' : 'Clicks the field at that pixel to focus it'}${step.clear_first ? ', empties it' : ''}, then types the text ${step.type_mode === 'keys' ? 'one key at a time (key down, input, key up for each character), so search boxes show their suggestions' : 'all at once'} and tells the page the value changed.${step.enter_after ? ' Then it presses Enter; if the page doesn\'t handle that itself, the field\'s form is submitted.' : ''}`;
    case 'key':
        return 'Sends key down, key press and key up to whatever has the focus. Enter in a form field also submits the form.';
    case 'scroll':
        return 'Scrolls the nearest scrollable box under that pixel (or the page).';
    case 'read':
        return `Takes the text of whatever is at that pixel (a field's value, or the words shown)${step.read_pattern ? `, keeps the part matching ${step.read_pattern}` : ''}, and remembers it as {${step.var_name}}: later steps can type it, and an "other site" step hands it back to the activity that opened this one.`;
    case 'side':
        return 'Opens the page next to this one (Chrome\'s split view, or a second window beside this one), plays the chosen activity there with the values read so far, waits until it finishes, brings back every value it read, then closes it and carries on here.';
    default:
        return 'Does nothing itself: only its checks and the pause run.';
    }
}

/*
 * side_name(step) -> name of the activity an 'other site' step plays, or a hint
 */
function side_name(step) {
    const other = step.side_activity === '' ? null : load_activity(step.side_activity);
    return other === null ? '(pick an activity)' : other.name;
}

/*
 * side_target(step) -> the host an 'other site' step opens
 */
function side_target(step) {
    const other = step.side_activity === '' ? null : load_activity(step.side_activity);
    const url = step.side_url !== '' ? step.side_url : (other === null ? '' : other.start_url);
    try {
        return new URL(url.replace(/\{[^}]*\}/g, 'x')).hostname;
    } catch (e) {
        return 'another site';
    }
}

/*
 * describe_place(step) -> how the point follows scrolling or resizing
 */
function describe_place(step) {
    if (step.place === 'element') {
        return 'it follows the element marked there, wherever the layout moves it (pinning, resizing, banners); without one, the pixel';
    }
    if (step.place === 'page') {
        return `on the page: marked with the page scrolled to (${step.scroll_x}, ${step.scroll_y}); it scrolls there if needed`;
    }
    if (step.place === 'scaled') {
        return `relative to the window: marked in a ${step.view_w}×${step.view_h} window and scaled to the current size`;
    }
    return 'a fixed spot on the screen, wherever the page is scrolled';
}

/*
 * activity_runs_on(activity, url) -> true if the activity is meant for that page
 */
function activity_runs_on(activity, url) {
    return glob_test(activity.pages || `${activity.site}/*`, url);
}

/*
 * activity_duration(activity) -> rough length of one loop in ms (pauses and waits only)
 */
function activity_duration(activity) {
    let total = 0;
    for (const step of activity.steps) {
        if (!step.enabled) {
            continue;
        }
        total += step.pause_ms + (step.repeat - 1) * step.repeat_pause_ms;
        if (step.action === 'long_press') {
            total += step.hold_ms * step.repeat;
        }
        for (const check of step.before.concat(step.after)) {
            if (check.kind === 'wait') {
                total += to_number(check.value, 0);
            }
        }
    }
    return total;
}

// ---------- src/core/store.js ----------

/*
 * Where activities live: one GM value holding every activity of every site, so the
 * panel can list a site's activities and other tabs see changes at once. A run that
 * a page load interrupts is kept per tab (GM_saveTab), so it carries on in that tab
 * only.
 *
 * GM values:
 *     fm_activities  { [id]: struct activity }
 *     fm_prefs       struct prefs
 *     fm_jobs        { [job id]: struct job_result }   answers of activities played on another site
 * Tab value (GM_getTab): { fm_run: struct saved_run | undefined }
 *
 * struct prefs {
 *     open: boolean;          panel open
 *     side: 'right' | 'left';
 *     show_marks: boolean;    numbered marks on the page while an activity is open
 *     tab_y: number;          where the edge tab sits, 0..1 of the window height
 *     last_activity: string;  activity open in the panel, reopened after a reload
 *     online_url: string;     page asked to tell whether the internet is on
 *     pinned: boolean;        the panel lives in Chrome's side panel
 * }
 *
 * struct saved_run {
 *     activity_id: string;
 *     step: number;           step being played when the page went away
 *     loop: number;           loop number, from 0
 *     phase: 'after' | 'start';   'after': the action ran, its "after" checks are next;
 *                             'start': the tab was switched to another device, play the step
 *     url_before: string;     URL just before the action (for "URL changed")
 *     vars: object;           values read so far
 *     job: struct job | null; set when this run plays for an activity on another site
 *     at: number;             when it was saved; old ones are ignored
 * }
 */

const ACTIVITIES_KEY = 'fm_activities';
const PREFS_KEY = 'fm_prefs';
const RUN_KEY = 'fm_run';
const JOBS_KEY = 'fm_jobs';
const RESUME_WINDOW_MS = 120000;   // a saved run older than this is not resumed

/*
 * prefs_default() -> struct prefs
 */
function prefs_default() {
    return { open: false, side: 'right', show_marks: true, tab_y: 0.4, last_activity: '', online_url: ONLINE_URL, pinned: false };
}

/*
 * load_prefs() -> struct prefs
 */
function load_prefs() {
    return Object.assign(prefs_default(), GM_getValue(PREFS_KEY, {}));
}

/*
 * save_prefs(prefs) — remember the panel's state
 */
function save_prefs(prefs) {
    GM_setValue(PREFS_KEY, prefs);
}

/*
 * load_all() -> { [id]: struct activity }
 */
function load_all() {
    const all = GM_getValue(ACTIVITIES_KEY, {});
    if (all === null || typeof all !== 'object') {
        return {};
    }
    for (const id of Object.keys(all)) {
        all[id] = activity_fix(all[id]);
    }
    return all;
}

/*
 * load_activity(id) -> struct activity or null
 */
function load_activity(id) {
    const all = load_all();
    return all[id] === undefined ? null : all[id];
}

/*
 * activities_for(url) -> the activities meant for that page, newest first
 */
function activities_for(url) {
    const all = load_all();
    const out = [];
    for (const id of Object.keys(all)) {
        if (activity_runs_on(all[id], url) || all[id].site === site_of(url)) {
            out.push(all[id]);
        }
    }
    out.sort(function (a, b) {
        return b.updated_at - a.updated_at;
    });
    return out;
}

/*
 * save_activity(activity) -> the stored copy (updated_at refreshed)
 */
function save_activity(activity) {
    const all = load_all();
    const copy = clone(activity);
    copy.updated_at = Date.now();
    all[copy.id] = copy;
    GM_setValue(ACTIVITIES_KEY, all);
    return copy;
}

/*
 * remove_activity(id) — forget an activity
 */
function remove_activity(id) {
    const all = load_all();
    delete all[id];
    GM_setValue(ACTIVITIES_KEY, all);
    mark_deleted(id);
}

/*
 * export_activities(list) -> JSON text for sharing or backup
 */
function export_activities(list) {
    return JSON.stringify({ followme: 1, exported_at: new Date().toISOString(), activities: list }, null, 2);
}

/*
 * import_activities(text) -> how many activities were added (each gets a new id)
 */
function import_activities(text) {
    const data = JSON.parse(text);
    const list = Array.isArray(data) ? data : data.activities;
    if (!Array.isArray(list)) {
        throw new Error('No activities in that text.');
    }
    let count = 0;
    for (const item of list) {
        if (!item || !Array.isArray(item.steps)) {
            continue;
        }
        const copy = Object.assign(activity_create(item.name || 'Imported', item.site || location.href), item);
        copy.id = new_id('act');
        save_activity(copy);
        count++;
    }
    return count;
}

/*
 * save_run_state(state) -> Promise; state null forgets it
 */
function save_run_state(state) {
    return new Promise(function (resolve) {
        GM_getTab(function (tab) {
            const next = Object.assign({}, tab || {});
            if (state === null) {
                delete next[RUN_KEY];
            } else {
                next[RUN_KEY] = Object.assign({ at: Date.now() }, state);
            }
            GM_saveTab(next);
            resolve();
        });
    });
}

/*
 * load_run_state() -> Promise<struct saved_run | null>, only a recent one
 */
function load_run_state() {
    return new Promise(function (resolve) {
        GM_getTab(function (tab) {
            const state = tab ? tab[RUN_KEY] : undefined;
            if (!state || Date.now() - state.at > RESUME_WINDOW_MS) {
                resolve(null);
                return;
            }
            resolve(state);
        });
    });
}

/*
 * struct job { id: string; activity_id: string; opener: string }   opener: the activity that asked
 * struct job_result { status: 'running' | 'done' | 'failed' | 'stopped'; vars: object; error: string; at: number }
 */

/*
 * load_job(id) -> struct job_result or null
 */
function load_job(id) {
    const jobs = GM_getValue(JOBS_KEY, {});
    return jobs !== null && typeof jobs === 'object' && jobs[id] !== undefined ? jobs[id] : null;
}

/*
 * save_job(id, result) — store a job's result; null forgets it. Results older than a
 * day are dropped on the way.
 */
function save_job(id, result) {
    const old = GM_getValue(JOBS_KEY, {});
    const jobs = {};
    for (const key of Object.keys(old || {})) {
        if (Date.now() - old[key].at < 86400000) {
            jobs[key] = old[key];
        }
    }
    if (result === null) {
        delete jobs[id];
    } else {
        jobs[id] = Object.assign({ vars: {}, error: '' }, result, { at: Date.now() });
    }
    GM_setValue(JOBS_KEY, jobs);
}

/*
 * all_activities() -> every stored activity, of every site, by name
 */
function all_activities() {
    const all = load_all();
    const out = [];
    for (const id of Object.keys(all)) {
        out.push(all[id]);
    }
    out.sort(function (a, b) {
        return a.name.localeCompare(b.name);
    });
    return out;
}

// ---------- src/core/gist.js ----------

/*
 * Keeping every activity in a private GitHub gist, as a backup and to share them
 * between computers. Each activity is one readable file in the gist
 * ("example.com--checkout--k9x-3.json"), and _followme.json lists deleted ones. The gist
 * keeps every earlier version (its revisions), so any old state can be brought back.
 *
 * A sync reads the gist, merges it with the activities here (per activity the newer one
 * wins; a deletion wins over anything older), stores the result here and writes back
 * whatever changed. It runs when you press Save, add a step, delete or import an
 * activity, and when followMe starts on a page (at most once a minute).
 *
 * GM values:
 *     fm_gist     struct gist_conf
 *     fm_deleted  { [activity id]: when it was deleted }
 *
 * struct gist_conf {
 *     token: string;           GitHub token with the "gist" scope
 *     gist_id: string;
 *     auto: boolean;           sync on save / add / start-up
 *     last_sync: number;       when the last sync finished, 0 = never
 *     error: string;           what went wrong last time, '' = fine
 *     url: string;             the gist's page
 * }
 */

const GIST_KEY = 'fm_gist';
const DELETED_KEY = 'fm_deleted';
const GIST_META = '_followme.json';
const GIST_API = 'https://api.github.com';
const GIST_PULL_EVERY_MS = 60000;      // start-up syncs at most this often
const DELETED_KEEP_MS = 90 * 86400000; // forget deletions after 90 days

const gist = { busy: null, again: false, timer: 0, listeners: [] };

/*
 * gist_conf() -> struct gist_conf
 */
function gist_conf() {
    return Object.assign({ token: '', gist_id: '', auto: true, last_sync: 0, error: '', url: '' }, GM_getValue(GIST_KEY, {}));
}

/*
 * gist_conf_set(change) -> struct gist_conf after merging change into it
 */
function gist_conf_set(change) {
    const conf = Object.assign(gist_conf(), change);
    GM_setValue(GIST_KEY, conf);
    for (const fn of gist.listeners) {
        try {
            fn(conf);
        } catch (e) {
            console.error('followMe:', e);
        }
    }
    return conf;
}

/*
 * on_gist_change(fn) — fn(conf) after every sync or settings change
 */
function on_gist_change(fn) {
    gist.listeners.push(fn);
}

/*
 * gist_ready() -> true when a token and a gist are set
 */
function gist_ready() {
    const conf = gist_conf();
    return conf.token !== '' && conf.gist_id !== '';
}

/*
 * mark_deleted(id) — remember a deletion so the sync removes it everywhere
 */
function mark_deleted(id) {
    const deleted = GM_getValue(DELETED_KEY, {});
    deleted[id] = Date.now();
    GM_setValue(DELETED_KEY, deleted);
}

/*
 * github(token, method, url, body) -> Promise of the parsed JSON answer; throws with
 *   GitHub's message on an error
 */
function github(token, method, url, body) {
    return new Promise(function (resolve, reject) {
        GM_xmlhttpRequest({
            method: method,
            url: url.startsWith('https://') ? url : `${GIST_API}${url}`,
            headers: {
                Accept: 'application/vnd.github+json',
                Authorization: `Bearer ${token}`,
                'X-GitHub-Api-Version': '2022-11-28',
                'Content-Type': 'application/json',
            },
            data: body === undefined ? undefined : JSON.stringify(body),
            timeout: 20000,
            anonymous: true,
            onload: function (response) {
                let data = null;
                try {
                    data = response.responseText ? JSON.parse(response.responseText) : null;
                } catch (e) {
                    data = response.responseText;
                }
                if (response.status >= 200 && response.status < 300) {
                    resolve(data);
                    return;
                }
                let why = data !== null && data.message ? data.message : `HTTP ${response.status}`;
                if (response.status === 401) {
                    why = 'the token is wrong or expired';
                } else if (response.status === 404) {
                    why = 'gist not found (or the token lacks the "gist" scope)';
                }
                reject(new Error(`GitHub: ${why}`));
            },
            onerror: function () {
                reject(new Error('GitHub could not be reached'));
            },
            ontimeout: function () {
                reject(new Error('GitHub did not answer in time'));
            },
        });
    });
}

/*
 * slug(text) -> "my-checkout-flow", safe for a file name
 */
function slug(text) {
    const s = String(text).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    return s.slice(0, 40) || 'activity';
}

/*
 * gist_file_name(activity) -> "example.com--checkout--k9x-3.json"
 */
function gist_file_name(activity) {
    let host = 'site';
    try {
        host = new URL(activity.site).hostname || 'site';
    } catch (e) {
        host = 'site';
    }
    return `${host}--${slug(activity.name)}--${slug(activity.id.slice(-8))}.json`;
}

/*
 * gist_content(activity) -> the activity as stored in the gist (no local-only fields)
 */
function gist_content(activity) {
    const copy = clone(activity);
    delete copy.unsaved;
    return `${JSON.stringify(copy, null, 2)}\n`;
}

/*
 * meta_content(deleted) -> the text of _followme.json
 */
function meta_content(deleted) {
    return `${JSON.stringify({
        followme: 2,
        about: 'followMe activities (https://github.com/vididvidid/DailyScripts/tree/main/followMe). One file per activity; this file lists deleted ones. Older versions: the gist\'s Revisions.',
        deleted: deleted,
    }, null, 2)}\n`;
}

/*
 * read_gist(conf) -> Promise<{ activities: { [id]: { activity, file, text } }, deleted, meta_text, url }>
 */
async function read_gist(conf) {
    const data = await github(conf.token, 'GET', `/gists/${encodeURIComponent(conf.gist_id)}`);
    const out = { activities: {}, deleted: {}, meta_text: '', url: data.html_url || '' };
    for (const name of Object.keys(data.files || {})) {
        const file = data.files[name];
        let text = file.content || '';
        if (file.truncated && file.raw_url) {
            text = await github(conf.token, 'GET', file.raw_url).then(function (raw) {
                return typeof raw === 'string' ? raw : JSON.stringify(raw);
            });
        }
        let parsed = null;
        try {
            parsed = JSON.parse(text);
        } catch (e) {
            parsed = null;
        }
        if (parsed === null || typeof parsed !== 'object') {
            continue;
        }
        if (name === GIST_META) {
            out.deleted = parsed.deleted || {};
            out.meta_text = text;
        } else if (typeof parsed.id === 'string' && Array.isArray(parsed.steps)) {
            out.activities[parsed.id] = { activity: activity_fix(parsed), file: name, text: text };
        }
    }
    return out;
}

/*
 * merge_deleted(a, b) -> every deletion of both, the later time when both have one;
 *   old ones are dropped
 */
function merge_deleted(a, b) {
    const out = {};
    for (const source of [a, b]) {
        for (const id of Object.keys(source)) {
            if (Date.now() - source[id] < DELETED_KEEP_MS && (out[id] === undefined || source[id] > out[id])) {
                out[id] = source[id];
            }
        }
    }
    return out;
}

/*
 * merge_activities(local, remote, deleted) -> { [id]: struct activity } after the sync:
 *   the newer copy of each, minus the deleted ones
 */
function merge_activities(local, remote, deleted) {
    const out = {};
    const ids = Object.keys(local);
    for (const id of Object.keys(remote)) {
        if (ids.indexOf(id) < 0) {
            ids.push(id);
        }
    }
    for (const id of ids) {
        const mine = local[id];
        const theirs = remote[id] === undefined ? undefined : remote[id].activity;
        let pick = mine;
        if (mine === undefined || (theirs !== undefined && theirs.updated_at > mine.updated_at)) {
            pick = theirs;
            if (mine !== undefined && mine.unsaved) {
                pick = Object.assign({}, theirs, { unsaved: [] });
            }
        }
        if (deleted[id] !== undefined && deleted[id] >= pick.updated_at) {
            continue;
        }
        out[id] = pick;
    }
    return out;
}

/*
 * sync_once() -> Promise<{ pulled, pushed }>: one full sync (read, merge, write back)
 */
async function sync_once() {
    const conf = gist_conf();
    const remote = await read_gist(conf);
    const local = load_all();
    const deleted = merge_deleted(GM_getValue(DELETED_KEY, {}), remote.deleted);
    const merged = merge_activities(local, remote.activities, deleted);

    // Here: take what the gist had newer, drop what was deleted elsewhere.
    let pulled = 0;
    for (const id of Object.keys(merged)) {
        if (local[id] === undefined || merged[id].updated_at !== local[id].updated_at) {
            pulled++;
        }
    }
    for (const id of Object.keys(local)) {
        if (merged[id] === undefined) {
            pulled++;
        }
    }
    if (pulled > 0) {
        GM_setValue(ACTIVITIES_KEY, merged);
    }
    GM_setValue(DELETED_KEY, deleted);

    // There: write the files that differ, remove the ones no longer wanted.
    const files = {};
    let pushed = 0;
    for (const id of Object.keys(merged)) {
        const name = gist_file_name(merged[id]);
        const text = gist_content(merged[id]);
        const old = remote.activities[id];
        if (old !== undefined && old.file !== name) {
            files[old.file] = null;
        }
        if (old === undefined || old.file !== name || old.text !== text) {
            files[name] = { content: text };
            pushed++;
        }
    }
    for (const id of Object.keys(remote.activities)) {
        if (merged[id] === undefined) {
            files[remote.activities[id].file] = null;
            pushed++;
        }
    }
    const meta = meta_content(deleted);
    if (meta !== remote.meta_text) {
        files[GIST_META] = { content: meta };
    }
    if (Object.keys(files).length > 0) {
        await github(conf.token, 'PATCH', `/gists/${encodeURIComponent(conf.gist_id)}`, { files: files });
    }
    gist_conf_set({ last_sync: Date.now(), error: '', url: remote.url });
    return { pulled: pulled, pushed: pushed };
}

/*
 * gist_sync() -> Promise<{ pulled, pushed } | null>; null when no gist is set. Syncs
 *   one at a time: a call during a sync runs once more after it.
 */
function gist_sync() {
    if (!gist_ready()) {
        return Promise.resolve(null);
    }
    if (gist.busy !== null) {
        gist.again = true;
        return gist.busy;
    }
    gist.busy = sync_once().catch(function (e) {
        gist_conf_set({ error: e.message });
        throw e;
    }).finally(function () {
        gist.busy = null;
        if (gist.again) {
            gist.again = false;
            gist_sync().catch(function () {});
        }
    });
    return gist.busy;
}

/*
 * gist_sync_soon() — sync in a moment (adding several steps quickly syncs once)
 */
function gist_sync_soon() {
    if (!gist_ready() || !gist_conf().auto) {
        return;
    }
    clearTimeout(gist.timer);
    gist.timer = setTimeout(function () {
        gist_sync().catch(function (e) {
            console.warn('followMe: gist sync failed:', e.message);
        });
    }, 1500);
}

/*
 * gist_sync_on_start() -> Promise; the start-up sync, at most once a minute
 */
function gist_sync_on_start() {
    const conf = gist_conf();
    if (!gist_ready() || !conf.auto || Date.now() - conf.last_sync < GIST_PULL_EVERY_MS) {
        return Promise.resolve(null);
    }
    return gist_sync().catch(function (e) {
        console.warn('followMe: gist sync failed:', e.message);
        return null;
    });
}

/*
 * gist_connect(token, gist_id) -> Promise<struct gist_conf>: use that gist, or find the
 *   followMe gist of that account, or make a new private one; then sync
 */
async function gist_connect(token, gist_id) {
    let id = gist_id.trim();
    const match = /([0-9a-f]{20,})\/?$/i.exec(id);
    if (match !== null) {
        id = match[1]; // a pasted gist URL
    }
    if (id === '') {
        const list = await github(token, 'GET', '/gists?per_page=100');
        for (const item of list) {
            if (item.files && item.files[GIST_META] !== undefined) {
                id = item.id;
                break;
            }
        }
    }
    if (id === '') {
        const made = await github(token, 'POST', '/gists', {
            description: 'followMe activities — synced by followMe (Moss)',
            public: false,
            files: { [GIST_META]: { content: meta_content({}) } },
        });
        id = made.id;
    }
    gist_conf_set({ token: token, gist_id: id, error: '', last_sync: 0 });
    await gist_sync();
    return gist_conf();
}

/*
 * gist_disconnect() — stop syncing (the gist itself stays on GitHub)
 */
function gist_disconnect() {
    gist_conf_set({ token: '', gist_id: '', last_sync: 0, error: '', url: '' });
}

/*
 * backup_text() -> every activity as one JSON file, for a download
 */
function backup_text() {
    return export_activities(all_activities());
}

// ---------- src/core/net.js ----------

/*
 * Is the internet on? navigator.onLine only says the computer is on a network (Wi-Fi
 * without internet still counts), so followMe also asks a tiny "no content" page on
 * the internet (prefs.online_url) through Moss, which a page's own rules can't block.
 * The answer is kept for a few seconds so checking before every step costs nothing.
 *
 * struct net (one, below) {
 *     online: boolean | null;   null = not checked yet
 *     checked_at: number;       when it was last asked
 *     asking: Promise | null;   the question in flight, shared by every caller
 *     listeners: function[];    called with the new answer when it changes
 * }
 */

const ONLINE_URL = 'https://www.gstatic.com/generate_204';
const ONLINE_CACHE_MS = 5000;     // answers younger than this are reused
const ONLINE_TIMEOUT_MS = 6000;   // no reply in this long = offline
const OFFLINE_RETRY_MS = 3000;    // how often to ask again while offline

const net = { online: null, checked_at: 0, asking: null, listeners: [] };

/*
 * on_online_change(fn) — fn(online) is called whenever the answer changes
 */
function on_online_change(fn) {
    net.listeners.push(fn);
}

/*
 * set_online(online) — store the answer and tell the listeners if it changed
 */
function set_online(online) {
    const changed = net.online !== online;
    net.online = online;
    net.checked_at = Date.now();
    if (!changed) {
        return;
    }
    for (const fn of net.listeners) {
        try {
            fn(online);
        } catch (e) {
            console.error('followMe:', e);
        }
    }
}

/*
 * probe(url) -> Promise<boolean>: true if the page at url answered
 */
function probe(url) {
    return new Promise(function (resolve) {
        if (typeof GM_xmlhttpRequest !== 'function') {
            resolve(navigator.onLine);
            return;
        }
        GM_xmlhttpRequest({
            method: 'HEAD',
            url: `${url}${url.indexOf('?') >= 0 ? '&' : '?'}fm=${Date.now()}`,
            timeout: ONLINE_TIMEOUT_MS,
            anonymous: true,
            onload: function (response) {
                resolve(response.status >= 200 && response.status < 400);
            },
            onerror: function () {
                resolve(false);
            },
            ontimeout: function () {
                resolve(false);
            },
        });
    });
}

/*
 * check_online(fresh) -> Promise<boolean>; fresh skips the kept answer
 */
async function check_online(fresh) {
    if (!navigator.onLine) {
        set_online(false);
        return false;
    }
    if (!fresh && net.online !== null && Date.now() - net.checked_at < ONLINE_CACHE_MS) {
        return net.online;
    }
    if (net.asking === null) {
        net.asking = probe(load_prefs().online_url || ONLINE_URL).then(function (online) {
            net.asking = null;
            set_online(online);
            return online;
        });
    }
    return net.asking;
}

/*
 * wait_online(run, timeout_ms, on_wait) -> 'ok' | 'timeout' | 'stopped' once the
 *   internet is on; timeout_ms 0 waits as long as it takes
 */
async function wait_online(run, timeout_ms, on_wait) {
    const end = timeout_ms > 0 ? Date.now() + timeout_ms : Infinity;
    while (true) {
        if (await check_online(true)) {
            return 'ok';
        }
        if (Date.now() >= end) {
            return 'timeout';
        }
        if (!(await sleep(run, Math.min(OFFLINE_RETRY_MS, end - Date.now()), typeof on_wait !== 'function' ? null : function () {
            on_wait(end === Infinity ? 0 : end - Date.now());
        }))) {
            return 'stopped';
        }
    }
}

/*
 * watch_network() — ask again as soon as the browser says the network came or went
 */
function watch_network() {
    window.addEventListener('online', function () {
        check_online(true);
    });
    window.addEventListener('offline', function () {
        set_online(false);
    });
}

// ---------- src/core/device.js ----------

/*
 * Which device the tab is shown as: Moss's GM_device emulates a phone or tablet with
 * Chrome's own device mode (screen size, touch, mobile user agent), so a site serves
 * and draws its mobile layout. Switching reloads the page.
 *
 * struct device_state { mode: 'desktop' | 'mobile' | 'tablet' | 'custom'; orientation: 'portrait' | 'landscape' }
 */

const DEVICES = { desktop: '🖥 Desktop', mobile: '📱 Mobile', tablet: '📲 Tablet' };
const ORIENTATIONS = { portrait: 'Portrait', landscape: 'Landscape' };

let device_current = { mode: 'desktop', orientation: 'portrait' };   // as device_now() last found it

/*
 * device_supported() -> true if this Moss can emulate devices
 */
function device_supported() {
    return typeof GM_device !== 'undefined' && GM_device !== null;
}

/*
 * device_now() -> Promise<struct device_state> of this tab
 */
async function device_now() {
    let state = { mode: 'desktop', orientation: 'portrait' };
    if (device_supported()) {
        const em = await GM_device.get();
        if (em !== null && em !== undefined) {
            state = { mode: em.mode, orientation: em.width > em.height ? 'landscape' : 'portrait' };
        }
    }
    device_current = state;
    return state;
}

/*
 * is_touch() -> true while the tab is shown as a phone or tablet (taps, not clicks)
 */
function is_touch() {
    return device_current.mode !== 'desktop';
}

/*
 * device_matches(state, mode, orientation) -> true if the tab already looks that way
 */
function device_matches(state, mode, orientation) {
    if (mode === 'desktop' || mode === undefined) {
        return state.mode === 'desktop';
    }
    return state.mode === mode && state.orientation === (orientation || 'portrait');
}

/*
 * device_switch(mode, orientation) -> Promise; shows the tab as that device (reloads it)
 */
async function device_switch(mode, orientation) {
    if (!device_supported()) {
        throw new Error('Mobile and tablet views need a Moss with GM_device (Moss 0.2+).');
    }
    if (mode === 'desktop') {
        await GM_device.clear();
    } else {
        await GM_device.set(mode, { orientation: orientation || 'portrait' });
    }
}

// ---------- src/core/checks.js ----------

/*
 * The checks a step can wait for, before or after its action:
 *
 *   loaded       the page has fully loaded: the document says "complete", and then
 *                nothing new was downloaded and nothing on the page changed for a
 *                short quiet time — so a single-page app that draws its content
 *                after "load" counts as loaded only once it settles
 *   url_changed  the address differs from the one before the action (single-page
 *                apps change it without reloading, so it is watched, not awaited)
 *   url_matches  the address matches a "*" glob or /regex/
 *   online       the internet is on (see net.js)
 *   wait         a fixed time
 *
 * Every wait returns 'ok', 'timeout' or 'stopped'.
 */

const QUIET_MS = 700;      // "settled" = this long with no downloads and no DOM changes
const POLL_MS = 100;

/*
 * resource_count() -> how many files the page has started downloading so far
 */
function resource_count() {
    try {
        return performance.getEntriesByType('resource').length;
    } catch (e) {
        return 0;
    }
}

/*
 * wait_until(run, timeout_ms, test, on_wait) -> 'ok' | 'timeout' | 'stopped';
 *   polls test() until it is true
 */
async function wait_until(run, timeout_ms, test, on_wait) {
    const end = Date.now() + timeout_ms;
    while (true) {
        if (run !== null && run.stopped) {
            return 'stopped';
        }
        if (test()) {
            return 'ok';
        }
        if (Date.now() >= end) {
            return 'timeout';
        }
        if (on_wait) {
            on_wait(end - Date.now());
        }
        await pause(POLL_MS);
    }
}

/*
 * wait_loaded(run, timeout_ms, on_wait) -> 'ok' | 'timeout' | 'stopped'
 */
async function wait_loaded(run, timeout_ms, on_wait) {
    const end = Date.now() + timeout_ms;
    const ready = await wait_until(run, timeout_ms, function () {
        return document.readyState === 'complete';
    }, on_wait);
    if (ready !== 'ok') {
        return ready;
    }
    // Then wait for a quiet moment: no new downloads, no DOM changes.
    let last_change = Date.now();
    let last_count = resource_count();
    const observer = new MutationObserver(function () {
        last_change = Date.now();
    });
    observer.observe(document.documentElement, { childList: true, subtree: true, attributes: true, characterData: true });
    try {
        return await wait_until(run, Math.max(0, end - Date.now()), function () {
            const count = resource_count();
            if (count !== last_count) {
                last_count = count;
                last_change = Date.now();
            }
            return Date.now() - last_change >= QUIET_MS;
        }, on_wait);
    } finally {
        observer.disconnect();
    }
}

/*
 * run_check(run, check, url_before, on_wait) -> 'ok' | 'timeout' | 'stopped'
 *   url_before: the address before the action this check belongs to
 */
async function run_check(run, check, url_before, on_wait) {
    const timeout = to_number(check.timeout_ms, DEFAULT_TIMEOUT);
    switch (check.kind) {
    case 'loaded':
        return wait_loaded(run, timeout, on_wait);
    case 'url_changed':
        return wait_until(run, timeout, function () {
            return location.href !== url_before;
        }, on_wait);
    case 'url_matches':
        return wait_until(run, timeout, function () {
            return glob_test(check.value, location.href);
        }, on_wait);
    case 'online':
        return wait_online(run, timeout, on_wait);
    case 'wait':
        return (await sleep(run, to_number(check.value, 0), on_wait)) ? 'ok' : 'stopped';
    default:
        return 'ok';
    }
}

/*
 * check_now(check, url_before) -> true if the check already holds (for the detail view)
 */
function check_now(check, url_before) {
    switch (check.kind) {
    case 'loaded':
        return document.readyState === 'complete';
    case 'url_changed':
        return location.href !== url_before;
    case 'url_matches':
        return glob_test(check.value, location.href);
    case 'online':
        return net.online === true;
    default:
        return true;
    }
}

// ---------- src/core/clicker.js ----------

/*
 * Acting on a pixel. No selectors: whatever the browser draws at (x, y) is the target,
 * found with elementFromPoint (through same-origin iframes too), and it gets the same
 * sequence of pointer, mouse, focus and click events a real click produces.
 *
 * While the tab is shown as a phone or tablet (device.js) a click is a tap instead:
 * pointer events of type "touch", touchstart / touchend, then the mouse events and
 * click a phone's browser makes after a tap.
 *
 * Limits of a userscript: these events are marked untrusted (event.isTrusted is
 * false), so a page that checks that, or a cross-origin iframe (a payment box, a
 * captcha), cannot be clicked this way.
 *
 * struct hit { el: Element; x, y: number; win: Window }   x, y inside el's own frame
 */

const own_layers = [];   // followMe's own overlays, skipped when looking for a target

/*
 * register_layer(el) — mark one of followMe's elements as "not part of the page"
 */
function register_layer(el) {
    own_layers.push(el);
}

/*
 * unregister_layer(el) — forget a removed layer
 */
function unregister_layer(el) {
    const i = own_layers.indexOf(el);
    if (i >= 0) {
        own_layers.splice(i, 1);
    }
}

/*
 * view_now() -> { scroll_x, scroll_y, w, h } of the window as it is now
 */
function view_now() {
    return { scroll_x: window.scrollX, scroll_y: window.scrollY, w: window.innerWidth, h: window.innerHeight };
}

/*
 * hit_at(x, y) -> struct hit for the element drawn at viewport pixel (x, y), or null
 */
function hit_at(x, y) {
    // Hide followMe's layers for the lookup (marks sit right on the target pixels).
    // visibility, not display: hit testing skips hidden boxes, but they keep their
    // layout and scroll position, and it is put back before the next paint.
    const saved = [];
    for (const layer of own_layers) {
        saved.push(layer.style.visibility);
        layer.style.visibility = 'hidden';
    }
    let doc = document;
    let win = window;
    let lx = x;
    let ly = y;
    let el = null;
    try {
        el = doc.elementFromPoint(lx, ly);
        // Step into same-origin iframes; a cross-origin one stays the target itself.
        while (el !== null && (el.tagName === 'IFRAME' || el.tagName === 'FRAME')) {
            let inner = null;
            try {
                inner = el.contentDocument;
            } catch (e) {
                inner = null;
            }
            if (inner === null) {
                break;
            }
            const box = el.getBoundingClientRect();
            lx -= box.left + el.clientLeft;
            ly -= box.top + el.clientTop;
            win = el.contentWindow;
            doc = inner;
            el = doc.elementFromPoint(lx, ly);
        }
    } finally {
        for (let i = 0; i < own_layers.length; i++) {
            own_layers[i].style.visibility = saved[i];
        }
    }
    return el === null ? null : { el: el, x: lx, y: ly, win: win };
}

/*
 * describe_target(el) -> 'button "Sign in"', 'input[email]', 'a "Next →"' …
 */
function describe_target(el) {
    if (el === null || el === undefined) {
        return 'nothing (outside the page)';
    }
    let name = el.tagName.toLowerCase();
    if (el.type && (name === 'input' || name === 'button')) {
        name += `[${el.type}]`;
    }
    const text = (el.getAttribute('aria-label') || el.getAttribute('placeholder') || el.innerText || el.value || el.title || el.alt || '')
        .replace(/\s+/g, ' ').trim();
    if (el.tagName === 'IFRAME') {
        return `${name} (another site's frame: clicks can't reach inside)`;
    }
    return text === '' ? name : `${name} "${text.length > 40 ? `${text.slice(0, 40)}…` : text}"`;
}

/*
 * mouse_init(hit, button, buttons, detail) -> the init dictionary shared by every event
 */
function mouse_init(hit, button, buttons, detail) {
    return {
        bubbles: true, cancelable: true, composed: true, view: hit.win,
        clientX: hit.x, clientY: hit.y, screenX: hit.x + window.screenX, screenY: hit.y + window.screenY,
        button: button, buttons: buttons, detail: detail,
        pointerId: 1, pointerType: is_touch() ? 'touch' : 'mouse', isPrimary: true, width: 1, height: 1, pressure: buttons ? 0.5 : 0,
    };
}

/*
 * fire(hit, type, init) — dispatch one pointer or mouse event on the target
 */
function fire(hit, type, init) {
    const make = type.startsWith('pointer') ? hit.win.PointerEvent : hit.win.MouseEvent;
    hit.el.dispatchEvent(new make(type, init));
}

/*
 * fire_touch(hit, type) -> false if the page cancelled the touch event
 */
function fire_touch(hit, type) {
    try {
        const point = new hit.win.Touch({
            identifier: 1, target: hit.el, clientX: hit.x, clientY: hit.y, pageX: hit.x + hit.win.scrollX, pageY: hit.y + hit.win.scrollY,
            screenX: hit.x + window.screenX, screenY: hit.y + window.screenY, radiusX: 4, radiusY: 4, force: 0.5,
        });
        const down = type !== 'touchend';
        return hit.el.dispatchEvent(new hit.win.TouchEvent(type, {
            bubbles: true, cancelable: true, composed: true, view: hit.win,
            touches: down ? [point] : [], targetTouches: down ? [point] : [], changedTouches: [point],
        }));
    } catch (e) {
        return true; // no touch support in this browser: the pointer and mouse events still go
    }
}

/*
 * tap_at(hit, detail) — a finger tap: touch first, then the mouse events and click a
 *   phone's browser sends after it (skipped when the page cancels the touch)
 */
function tap_at(hit, detail) {
    fire(hit, 'pointerover', mouse_init(hit, 0, 0, 0));
    fire(hit, 'pointerdown', mouse_init(hit, 0, 1, detail));
    fire_touch(hit, 'touchstart');
    focus_target(hit.el);
    fire(hit, 'pointerup', mouse_init(hit, 0, 0, detail));
    const go_on = fire_touch(hit, 'touchend');
    fire(hit, 'pointerout', mouse_init(hit, 0, 0, 0));
    if (!go_on) {
        return;
    }
    fire(hit, 'mouseover', mouse_init(hit, 0, 0, 0));
    fire(hit, 'mousemove', mouse_init(hit, 0, 0, 0));
    fire(hit, 'mousedown', mouse_init(hit, 0, 1, detail));
    fire(hit, 'mouseup', mouse_init(hit, 0, 0, detail));
    fire(hit, 'click', mouse_init(hit, 0, 0, detail));
}

/*
 * focus_target(el) — focus el, or its nearest focusable ancestor
 */
function focus_target(el) {
    let node = el;
    while (node !== null && node !== undefined) {
        if (typeof node.focus === 'function' && (node.tabIndex >= 0 || node.isContentEditable)) {
            node.focus({ preventScroll: true });
            return;
        }
        node = node.parentElement;
    }
}

/*
 * press(hit, button) — move over the target and push a button down
 */
function press(hit, button) {
    const buttons = button === 2 ? 2 : 1;
    fire(hit, 'pointerover', mouse_init(hit, 0, 0, 0));
    fire(hit, 'mouseover', mouse_init(hit, 0, 0, 0));
    fire(hit, 'pointermove', mouse_init(hit, 0, 0, 0));
    fire(hit, 'mousemove', mouse_init(hit, 0, 0, 0));
    fire(hit, 'pointerdown', mouse_init(hit, button, buttons, 1));
    fire(hit, 'mousedown', mouse_init(hit, button, buttons, 1));
    if (button === 0) {
        focus_target(hit.el);
    }
}

/*
 * release(hit, button, detail) — let the button go; a left button also clicks
 */
function release(hit, button, detail) {
    fire(hit, 'pointerup', mouse_init(hit, button, 0, detail));
    fire(hit, 'mouseup', mouse_init(hit, button, 0, detail));
    if (button === 0) {
        fire(hit, 'click', mouse_init(hit, 0, 0, detail));
    } else if (button === 2) {
        fire(hit, 'contextmenu', mouse_init(hit, 2, 0, 1));
    }
}

/*
 * click_at(hit, kind) — 'click', 'double_click' or 'right_click'
 */
function click_at(hit, kind) {
    if (kind === 'right_click') {
        press(hit, 2);
        release(hit, 2, 1);
        return;
    }
    if (is_touch()) {
        tap_at(hit, 1);
        if (kind === 'double_click') {
            tap_at(hit, 2);
            fire(hit, 'dblclick', mouse_init(hit, 0, 0, 2));
        }
        return;
    }
    press(hit, 0);
    release(hit, 0, 1);
    if (kind === 'double_click') {
        press(hit, 0);
        release(hit, 0, 2);
        fire(hit, 'dblclick', mouse_init(hit, 0, 0, 2));
    }
}

/*
 * long_press_at(run, hit, hold_ms) -> Promise; holds the left button down for hold_ms
 */
async function long_press_at(run, hit, hold_ms) {
    if (is_touch()) {
        fire(hit, 'pointerdown', mouse_init(hit, 0, 1, 1));
        fire_touch(hit, 'touchstart');
        await sleep(run, hold_ms, null);
        fire(hit, 'pointerup', mouse_init(hit, 0, 0, 1));
        fire_touch(hit, 'touchend');
        return;
    }
    press(hit, 0);
    await sleep(run, hold_ms, null);
    release(hit, 0, 1);
}

/*
 * set_value(el, value) — set a form field's value the way typing does, so frameworks
 * that watch the field (React, Vue, …) notice
 */
function set_value(el, value) {
    const proto = el.tagName === 'TEXTAREA' ? HTMLTextAreaElement.prototype : (el.tagName === 'SELECT' ? HTMLSelectElement.prototype : HTMLInputElement.prototype);
    const setter = Object.getOwnPropertyDescriptor(proto, 'value').set;
    setter.call(el, value);
    el.dispatchEvent(new Event('input', { bubbles: true, composed: true }));
    el.dispatchEvent(new Event('change', { bubbles: true }));
}

/*
 * deep_focus(doc) -> the element that really has the focus: through same-origin iframes
 *   and open shadow roots; null when it is the page itself or one of followMe's layers
 */
function deep_focus(doc) {
    let el = doc.activeElement;
    while (el !== null) {
        if (own_layers.indexOf(el) >= 0) {
            return null;
        }
        if ((el.tagName === 'IFRAME' || el.tagName === 'FRAME')) {
            let inner = null;
            try {
                inner = el.contentDocument;
            } catch (e) {
                inner = null;
            }
            if (inner === null || inner.activeElement === null) {
                return el;
            }
            el = inner.activeElement;
        } else if (el.shadowRoot && el.shadowRoot.activeElement) {
            el = el.shadowRoot.activeElement;
        } else {
            break;
        }
    }
    return el === null || el === el.ownerDocument.body || el === el.ownerDocument.documentElement ? null : el;
}

/*
 * typable(el) -> true if text can be typed into el
 */
function typable(el) {
    return el !== null && (el.isContentEditable || el.tagName === 'INPUT' || el.tagName === 'TEXTAREA');
}

/*
 * key_init(key) -> the init dictionary of a keyboard event for key
 */
function key_init(key) {
    const code = KEY_CODES[key] !== undefined ? KEY_CODES[key] : key.toUpperCase().charCodeAt(0);
    let name = key;
    if (key.length === 1) {
        name = /[a-z]/i.test(key) ? `Key${key.toUpperCase()}` : (/[0-9]/.test(key) ? `Digit${key}` : (key === ' ' ? 'Space' : ''));
    }
    return { key: key, code: name, keyCode: code, which: code, bubbles: true, cancelable: true, composed: true };
}

/*
 * insert_char(field, ch) — type one character the way a key press does: keydown,
 *   keypress, beforeinput, the new value, input, keyup (skipped if the page cancels it)
 */
function insert_char(field, ch) {
    const win = field.ownerDocument.defaultView;
    const init = key_init(ch);
    if (!field.dispatchEvent(new win.KeyboardEvent('keydown', init))) {
        field.dispatchEvent(new win.KeyboardEvent('keyup', init));
        return;
    }
    field.dispatchEvent(new win.KeyboardEvent('keypress', init));
    const before = new win.InputEvent('beforeinput', { inputType: 'insertText', data: ch, bubbles: true, cancelable: true, composed: true });
    if (field.dispatchEvent(before)) {
        if (field.isContentEditable) {
            field.ownerDocument.execCommand('insertText', false, ch);
        } else {
            const proto = field.tagName === 'TEXTAREA' ? win.HTMLTextAreaElement.prototype : win.HTMLInputElement.prototype;
            Object.getOwnPropertyDescriptor(proto, 'value').set.call(field, field.value + ch);
            field.dispatchEvent(new win.InputEvent('input', { inputType: 'insertText', data: ch, bubbles: true, composed: true }));
        }
    }
    field.dispatchEvent(new win.KeyboardEvent('keyup', init));
}

/*
 * type_into(run, field, text, step) -> Promise; types text into field as the step says
 *   (clear first, key by key or all at once, Enter after)
 */
async function type_into(run, field, text, step) {
    if (!typable(field)) {
        throw new Error(`Nothing to type into: the focus is on ${describe_target(field)}.`);
    }
    if (typeof field.focus === 'function') {
        field.focus({ preventScroll: true });
    }
    const doc = field.ownerDocument;
    if (step.clear_first) {
        if (field.isContentEditable) {
            doc.execCommand('selectAll', false, null);
            doc.execCommand('delete', false, null);
        } else if (field.value !== '') {
            set_value(field, '');
        }
    }
    if (step.type_mode === 'keys') {
        for (const ch of Array.from(text)) {
            if (run !== null && run.stopped) {
                return;
            }
            insert_char(field, ch);
            await sleep(run, with_jitter(to_number(step.key_delay_ms, 60), to_number(step.key_delay_ms, 60) / 2), null);
        }
        if (!field.isContentEditable) {
            field.dispatchEvent(new Event('change', { bubbles: true }));
        }
    } else if (field.isContentEditable) {
        doc.execCommand('insertText', false, text);
    } else {
        set_value(field, field.value + text);
    }
    if (step.enter_after) {
        press_key_on(field, 'Enter');
    }
}

let last_page_focus = null;   // the page's last focused element, while followMe's panel has the focus

/*
 * watch_focus() — remember which element of the page last had the focus, so "type into
 *   the focused field" still works after a click on followMe's panel (▶ Test this step)
 */
function watch_focus() {
    document.addEventListener('focusin', function () {
        const el = deep_focus(document);
        if (el !== null) {
            last_page_focus = el;
        }
    }, true);
}

/*
 * focused_field() -> the field that has the focus (or had it before followMe's panel
 *   took it); throws when there is none
 */
function focused_field() {
    let el = deep_focus(document);
    if (el === null && last_page_focus !== null && last_page_focus.isConnected) {
        el = last_page_focus;
    }
    if (el === null) {
        throw new Error('No field has the focus. Add a click on the field before this step, or set "Type into" to the field at a point.');
    }
    return el;
}

/*
 * type_at(run, hit, text, step) -> Promise; click the field at the point, then type
 */
async function type_at(run, hit, text, step) {
    click_at(hit, 'click');
    let field = deep_focus(hit.el.ownerDocument);
    if (!typable(field)) {
        field = hit.el;
    }
    if (!typable(field)) {
        throw new Error(`Nothing to type into at that spot (found ${describe_target(field)}).`);
    }
    await type_into(run, field, text, step);
}

const READ_LIMIT = 10000;   // longest text a 'read' step keeps

/*
 * read_at(hit, pattern) -> the text at the point: a field's value or the words shown,
 *   cut down to the first group (or the whole match) of pattern when one is given
 */
function read_at(hit, pattern) {
    const el = hit.el;
    let text = '';
    if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT') {
        text = el.value;
    } else {
        text = el.innerText || el.textContent || el.getAttribute('aria-label') || el.alt || '';
    }
    text = text.replace(/\s+/g, ' ').trim().slice(0, READ_LIMIT);
    if (pattern) {
        const m = regex_of(pattern).exec(text);
        if (m === null) {
            throw new Error(`The text there ("${text.length > 60 ? `${text.slice(0, 60)}…` : text}") doesn't match ${pattern}.`);
        }
        text = m[1] !== undefined ? m[1] : m[0];
    }
    return text;
}

const KEY_CODES = { Enter: 13, Escape: 27, Tab: 9, Backspace: 8, Delete: 46, ArrowUp: 38, ArrowDown: 40, ArrowLeft: 37, ArrowRight: 39, ' ': 32 };

/*
 * press_key_on(el, key) — key down, press and up on el. Enter that the page doesn't
 *   handle itself (doesn't cancel) submits the field's form, as a real Enter would —
 *   untrusted key events don't do that by themselves. A search box like Google's is a
 *   <textarea> in a form, so that counts too.
 */
function press_key_on(el, key) {
    const win = el.ownerDocument.defaultView;
    const init = key_init(key);
    const down = el.dispatchEvent(new win.KeyboardEvent('keydown', init));
    if (key.length === 1 || key === 'Enter') {
        el.dispatchEvent(new win.KeyboardEvent('keypress', init));
    }
    el.dispatchEvent(new win.KeyboardEvent('keyup', init));
    if (down && key === 'Enter' && el.form && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA')) {
        el.form.requestSubmit();
    }
}

/*
 * press_key(key) — press key on whatever has the focus (the page, if nothing has)
 */
function press_key(key) {
    const el = deep_focus(document);
    press_key_on(el === null ? document.body : el, key);
}

/*
 * scroll_at(hit, dx, dy) — scroll the nearest scrollable box under the point, or the page
 */
function scroll_at(hit, dx, dy) {
    let node = hit === null ? null : hit.el;
    while (node !== null && node !== document.body && node !== document.documentElement) {
        const style = getComputedStyle(node);
        const can_y = dy !== 0 && /(auto|scroll)/.test(style.overflowY) && node.scrollHeight > node.clientHeight;
        const can_x = dx !== 0 && /(auto|scroll)/.test(style.overflowX) && node.scrollWidth > node.clientWidth;
        if (can_y || can_x) {
            node.scrollBy({ left: dx, top: dy, behavior: 'smooth' });
            return;
        }
        node = node.parentElement;
    }
    window.scrollBy({ left: dx, top: dy, behavior: 'smooth' });
}

/*
 * bring_into_view(step) -> struct found for the step's point, scrolling first when it is
 * off screen (to the element it follows, or a 'page' point's scroll position)
 */
function bring_into_view(step) {
    let point = point_of(step);
    const off = point.x < 0 || point.y < 0 || point.x >= window.innerWidth || point.y >= window.innerHeight;
    if (off && point.el !== null) {
        point.el.scrollIntoView({ block: 'center', inline: 'nearest', behavior: 'instant' });
        point = point_of(step);
    } else if (off && step.place === 'page') {
        window.scrollTo({ left: step.scroll_x, top: step.scroll_y, behavior: 'instant' });
        point = point_of(step);
    }
    return point;
}

/*
 * do_action(run, step) -> Promise of the text read by a 'read' step, else undefined;
 *   performs the step's action once ('side' steps are the runner's)
 */
async function do_action(run, step) {
    if (step.action === 'wait' || step.action === 'side') {
        return undefined;
    }
    if (step.action === 'key') {
        press_key(step.key);
        return undefined;
    }
    const text = step.action === 'type' ? fill_vars(step.text, run === null ? null : run.vars) : '';
    if (step.action === 'type' && step.type_into === 'focused') {
        await type_into(run, focused_field(), text, step);
        return undefined;
    }
    const point = bring_into_view(step);
    const hit = hit_at(point.x, point.y);
    if (step.action === 'scroll') {
        scroll_at(hit, to_number(step.scroll_dx, 0), to_number(step.scroll_dy, 0));
        return undefined;
    }
    if (hit === null) {
        throw new Error(`Nothing at (${Math.round(point.x)}, ${Math.round(point.y)}): the point is outside the page.`);
    }
    if (step.action === 'read') {
        return read_at(hit, step.read_pattern);
    }
    if (step.action === 'long_press') {
        await long_press_at(run, hit, step.hold_ms);
    } else if (step.action === 'type') {
        await type_at(run, hit, text, step);
    } else {
        click_at(hit, step.action);
    }
    return undefined;
}

// ---------- src/core/anchor.js ----------

/*
 * Points that follow the page. A pixel alone breaks as soon as the layout moves: a
 * narrower window (pinning the side panel), a banner that appears, a centred page in a
 * different window size. So when you mark a point, followMe also notes the element
 * drawn there and where inside it you clicked (as a share of its width and height).
 * When the step plays it finds that element again and clicks the same spot inside it,
 * wherever the layout put it. You still only mark pixels; this happens by itself.
 *
 * Finding the element again, in order:
 *   1. its path from the nearest element with a stable id ("#main > div:nth-of-type(2) > button")
 *      — if the element there is still the same kind and says the same thing
 *   2. an element of the same kind saying the same thing (label, then text), the one
 *      nearest to where the point was
 *   3. the element at the path even if its text changed (a counter, a price)
 *   4. none: the marked pixel itself
 *
 * struct anchor {
 *     path: string;     CSS path from the nearest stable id (or the body)
 *     tag: string;      "button"
 *     text: string;     its words, up to 80 characters
 *     label: string;    aria-label / placeholder / name / title / alt
 *     fx, fy: number;   where inside it the point is, 0..1 of its width and height
 *     x, y: number;     the point in the window when it was marked
 * }
 * struct found { x, y: number; el: Element | null; how: 'path' | 'text' | 'moved' | 'pixel' }
 */

const ANCHOR_TARGETS = 'a, button, input, select, textarea, label, summary, [role="button"], [role="link"], [role="tab"], [role="menuitem"], [role="option"], [role="checkbox"], [onclick], [tabindex]';
const ANCHOR_SEARCH_LIMIT = 3000;   // elements of one kind looked at when the path fails

/*
 * top_element_at(x, y) -> the page's own element at (x, y) in the top document (an
 *   iframe counts as one element), skipping followMe's layers
 */
function top_element_at(x, y) {
    const saved = [];
    for (const layer of own_layers) {
        saved.push(layer.style.visibility);
        layer.style.visibility = 'hidden';
    }
    try {
        return document.elementFromPoint(x, y);
    } finally {
        for (let i = 0; i < own_layers.length; i++) {
            own_layers[i].style.visibility = saved[i];
        }
    }
}

/*
 * stable_id(el) -> el's id if it is unique and doesn't look generated, else ''
 */
function stable_id(el) {
    const id = el.id;
    if (!id || /\d{4,}|^[a-f0-9-]{12,}$|^(ember|react|vue|ng|mui|radix|headlessui)[-_:]/i.test(id) || id.indexOf(':') >= 0) {
        return '';
    }
    try {
        return document.querySelectorAll(`#${CSS.escape(id)}`).length === 1 ? id : '';
    } catch (e) {
        return '';
    }
}

/*
 * css_path(el) -> "#main > div:nth-of-type(2) > button:nth-of-type(1)"
 */
function css_path(el) {
    const parts = [];
    let node = el;
    while (node !== null && node.nodeType === 1 && node !== document.body && node !== document.documentElement) {
        const id = stable_id(node);
        if (id !== '') {
            parts.unshift(`#${CSS.escape(id)}`);
            return parts.join(' > ');
        }
        let n = 1;
        let sib = node.previousElementSibling;
        while (sib !== null) {
            if (sib.tagName === node.tagName) {
                n++;
            }
            sib = sib.previousElementSibling;
        }
        parts.unshift(`${node.tagName.toLowerCase()}:nth-of-type(${n})`);
        node = node.parentElement;
    }
    parts.unshift('body');
    return parts.join(' > ');
}

/*
 * text_of(el) -> el's words, squeezed, up to 80 characters
 */
function text_of(el) {
    const raw = el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.tagName === 'SELECT' ? '' : (el.innerText || el.textContent || '');
    return raw.replace(/\s+/g, ' ').trim().slice(0, 80);
}

/*
 * label_of(el) -> what el is called besides its text
 */
function label_of(el) {
    return (el.getAttribute('aria-label') || el.getAttribute('placeholder') || el.getAttribute('name') || el.getAttribute('title') || el.getAttribute('alt') || '').trim().slice(0, 80);
}

/*
 * anchor_at(x, y) -> struct anchor for the point, or null when there is nothing to hold
 *   on to (the bare page, or something huge)
 */
function anchor_at(x, y) {
    let el = top_element_at(x, y);
    if (el === null || el === document.body || el === document.documentElement) {
        return null;
    }
    const target = el.closest(ANCHOR_TARGETS);
    if (target !== null && target !== document.body) {
        el = target;
    }
    const box = el.getBoundingClientRect();
    if (box.width < 1 || box.height < 1 || (box.width >= window.innerWidth * 0.9 && box.height >= window.innerHeight * 0.9)) {
        return null; // a whole-page box says nothing about where the point is
    }
    return {
        path: css_path(el),
        tag: el.tagName.toLowerCase(),
        text: text_of(el),
        label: label_of(el),
        fx: clamp((x - box.left) / box.width, 0, 1),
        fy: clamp((y - box.top) / box.height, 0, 1),
        x: Math.round(x),
        y: Math.round(y),
    };
}

/*
 * same_words(el, a) -> true if el is called / says what the anchor noted
 */
function same_words(el, a) {
    if (a.label !== '') {
        return label_of(el) === a.label;
    }
    if (a.text !== '') {
        return text_of(el) === a.text;
    }
    return true;
}

/*
 * shown(el) -> true if el takes up space on the page
 */
function shown(el) {
    const box = el.getBoundingClientRect();
    return box.width > 0 && box.height > 0;
}

/*
 * find_anchor(a) -> { el, how } for the element the anchor describes, or { el: null }
 */
function find_anchor(a) {
    let at_path = null;
    try {
        at_path = document.querySelector(a.path);
    } catch (e) {
        at_path = null;
    }
    if (at_path !== null && at_path.tagName.toLowerCase() === a.tag && same_words(at_path, a) && shown(at_path)) {
        return { el: at_path, how: 'path' };
    }
    if (a.label !== '' || a.text !== '') {
        const all = document.getElementsByTagName(a.tag);
        let best = null;
        let best_d = Infinity;
        for (let i = 0; i < all.length && i < ANCHOR_SEARCH_LIMIT; i++) {
            const el = all[i];
            if (!same_words(el, a) || !shown(el)) {
                continue;
            }
            const box = el.getBoundingClientRect();
            const d = Math.hypot(box.left + box.width * a.fx - a.x, box.top + box.height * a.fy - a.y);
            if (d < best_d) {
                best = el;
                best_d = d;
            }
        }
        if (best !== null) {
            return { el: best, how: 'text' };
        }
    }
    if (at_path !== null && at_path.tagName.toLowerCase() === a.tag && shown(at_path)) {
        return { el: at_path, how: 'moved' };
    }
    return { el: null, how: 'pixel' };
}

/*
 * point_of(step) -> struct found: where the step acts now
 */
function point_of(step) {
    if (step.place === 'element' && step.anchor) {
        const f = find_anchor(step.anchor);
        if (f.el !== null) {
            const box = f.el.getBoundingClientRect();
            return { x: box.left + box.width * step.anchor.fx, y: box.top + box.height * step.anchor.fy, el: f.el, how: f.how };
        }
    }
    const p = step_point(step, view_now());
    return { x: p.x, y: p.y, el: null, how: 'pixel' };
}

/*
 * set_point(step, x, y) — the step now acts at (x, y): its pixel, the view, and (for
 *   'element' points) a fresh anchor
 */
function set_point(step, x, y) {
    const view = view_now();
    step.x = Math.round(x);
    step.y = Math.round(y);
    step.scroll_x = Math.round(view.scroll_x);
    step.scroll_y = Math.round(view.scroll_y);
    step.view_w = view.w;
    step.view_h = view.h;
    step.anchor = step.place === 'element' ? anchor_at(x, y) : null;
}

/*
 * describe_found(step) -> "button "Checkout" — found where it was" for the detail view
 */
function describe_found(step) {
    if (step.place !== 'element') {
        return '';
    }
    if (!step.anchor) {
        return 'Nothing to follow at that spot (the bare page), so it uses the pixel.';
    }
    const f = find_anchor(step.anchor);
    const what = `${step.anchor.tag}${step.anchor.label ? ` "${step.anchor.label}"` : (step.anchor.text ? ` "${step.anchor.text.slice(0, 40)}"` : '')}`;
    const how = {
        path: 'found ✓',
        text: 'found by its words ✓ (it moved in the page)',
        moved: 'found where it was, but its words changed',
        pixel: 'not on the page now: it uses the marked pixel',
    };
    return `Follows ${what} — ${how[f.how]}.`;
}

// ---------- src/core/runner.js ----------

/*
 * Playing an activity: for each step, wait for its "before" checks, do the action
 * (repeat times), wait for its "after" checks, then take the step's pause. Loops as
 * often as the activity says. Only one run at a time per tab.
 *
 * A click that loads a new page ends this script, so just before every action the run
 * is saved for this tab. When followMe starts on the next page it finds that and
 * carries on with the step's "after" checks ("URL changed" is then already true).
 *
 * Before the first step the tab is switched to the activity's device (mobile, tablet,
 * desktop) if it isn't shown that way yet; that reloads the page, and the run starts
 * again from the saved state. Before every step, an activity that needs the internet
 * checks it is on, and waits for it (or stops) when it is not.
 *
 * An "other site" step opens a page beside this one with GM_split, and followMe there
 * finds the job in GM_split.data(), plays the activity, and puts what it read in
 * fm_jobs; this side waits for that, takes the values, and closes the page.
 *
 * struct run {
 *     activity: struct activity;
 *     stopped: boolean;        set by stop_run(); every wait notices within 100 ms
 *     step: number;            index of the step being played
 *     loop: number;            loop number, from 0
 *     phase: 'before' | 'action' | 'after' | 'pause' | 'done' | 'failed' | 'stopped';
 *     text: string;            what it is doing, for the panel
 *     left_ms: number;         time left in the current wait, or 0
 *     last_url: string;        URL before the previous action ("before: URL changed")
 *     vars: object;            values read so far ({name} in texts and URLs)
 *     job: struct job | null;  this run plays for an activity on another site
 *     side_id: number | null;  page opened beside this one by the step playing now
 *     switched: boolean;       the page was just reloaded to switch the device
 *     error: string;
 * }
 */

let current_run = null;
const run_listeners = [];

/*
 * on_run_change(fn) — fn(run) is called whenever the current run changes
 */
function on_run_change(fn) {
    run_listeners.push(fn);
}

/*
 * notify(run) — tell the panel and the marks
 */
function notify(run) {
    for (const fn of run_listeners) {
        try {
            fn(run);
        } catch (e) {
            console.error('followMe:', e);
        }
    }
}

/*
 * set_phase(run, phase, text) — update what the run is doing
 */
function set_phase(run, phase, text) {
    run.phase = phase;
    run.text = text;
    run.left_ms = 0;
    notify(run);
}

/*
 * ticker(run) -> an on_wait callback that shows the time left (at most ~5 times a second)
 */
function ticker(run) {
    let last = 0;
    return function (left_ms) {
        if (Date.now() - last < 200) {
            return;
        }
        last = Date.now();
        run.left_ms = left_ms;
        notify(run);
    };
}

/*
 * run_checks(run, checks, url_before, when) -> true to go on, false to end the run
 */
async function run_checks(run, checks, url_before, when) {
    for (const check of checks) {
        set_phase(run, when, `${step_title(run.activity.steps[run.step], run.step)}: waiting until ${describe_check(check)}`);
        const result = await run_check(run, check, url_before, ticker(run));
        if (result === 'stopped') {
            return false;
        }
        if (result === 'timeout' && check.on_timeout === 'stop') {
            run.error = `${step_title(run.activity.steps[run.step], run.step)}: gave up waiting until ${describe_check(check)}.`;
            return false;
        }
    }
    return true;
}

/*
 * saved(run, extra) -> struct saved_run for this run, with extra fields
 */
function saved(run, extra) {
    return Object.assign({ activity_id: run.activity.id, step: run.step, loop: run.loop, vars: run.vars, job: run.job }, extra);
}

/*
 * gate_online(run) -> true to go on: the internet is on, or came back while waiting
 */
async function gate_online(run) {
    if (!run.activity.need_online || (await check_online(false))) {
        return true;
    }
    if (run.activity.offline === 'stop') {
        run.error = 'No internet connection, so it stopped.';
        return false;
    }
    set_phase(run, 'before', 'No internet connection — waiting for it to come back');
    const result = await wait_online(run, 0, ticker(run));
    if (result !== 'ok') {
        return false;
    }
    toast('Internet is back — carrying on');
    return true;
}

/*
 * ensure_device(run) -> 'ok', or 'reloading' when the tab is being switched to the
 *   activity's device (the run carries on after the reload)
 */
async function ensure_device(run) {
    const a = run.activity;
    const state = await device_now();
    if (device_matches(state, a.device, a.orientation)) {
        return 'ok';
    }
    if (a.device === 'desktop' && !device_supported()) {
        return 'ok';
    }
    if (run.switched) {
        throw new Error(`The tab could not be shown as ${DEVICES[a.device] || a.device} (was Chrome's debugging bar cancelled?).`);
    }
    await save_run_state(saved(run, { phase: 'start', url_before: location.href }));
    set_phase(run, 'action', `Showing the page as ${DEVICES[a.device] || a.device} — it reloads`);
    await device_switch(a.device, a.orientation);
    return 'reloading';
}

/*
 * side_wait(run, step, opened, job_id) -> struct job_result, or null when the run was
 *   stopped; throws when the other page closed or took too long
 */
async function side_wait(run, step, opened, job_id) {
    const end = Date.now() + to_number(step.side_timeout_ms, 120000);
    let last_look = 0;
    while (true) {
        if (run.stopped) {
            return null;
        }
        const result = load_job(job_id);
        if (result !== null && result.status !== 'running') {
            return result;
        }
        if (Date.now() >= end) {
            throw new Error(`"${side_name(step)}" didn't finish within ${format_ms(step.side_timeout_ms)}.`);
        }
        if (Date.now() - last_look > 1000) {
            last_look = Date.now();
            if (!(await GM_split.isOpen(opened.id))) {
                throw new Error(`The page of "${side_name(step)}" was closed before it finished.`);
            }
        }
        run.left_ms = end - Date.now();
        notify(run);
        await pause(300);
    }
}

/*
 * play_side(run, step) -> Promise; an "other site" step: open the page beside this one,
 *   let followMe there play the activity, and bring back what it read
 */
async function play_side(run, step) {
    const other = step.side_activity === '' ? null : load_activity(step.side_activity);
    if (other === null) {
        throw new Error('Pick the activity to play on the other site.');
    }
    if (typeof GM_split === 'undefined') {
        throw new Error('Running on another site needs a Moss with GM_split (Moss 0.2+).');
    }
    const url = fill_vars(step.side_url !== '' ? step.side_url : other.start_url, run.vars);
    const job_id = new_id('job');
    save_job(job_id, { status: 'running' });
    const opts = { side: step.side_place, data: { followme_job: { id: job_id, activity_id: other.id, opener: run.activity.name, vars: run.vars } } };
    if (step.side_how !== 'auto') {
        opts.how = step.side_how;
    }
    const opened = await GM_split.open(url, opts);
    run.side_id = opened.id;
    let result = null;
    try {
        result = await side_wait(run, step, opened, job_id);
    } finally {
        run.side_id = null;
        save_job(job_id, null);
        if (step.side_close || result === null) {
            await GM_split.close(opened.id).catch(function () {});
        }
    }
    if (result === null) {
        return;
    }
    Object.assign(run.vars, result.vars || {});
    if (result.status !== 'done') {
        throw new Error(`On ${side_target(step)}: ${result.error || result.status}`);
    }
}

/*
 * perform(run, step) -> Promise; the step's action once, keeping what a 'read' step read
 */
async function perform(run, step) {
    if (step.action === 'side') {
        await play_side(run, step);
        return;
    }
    const value = await do_action(run, step);
    if (step.action === 'read') {
        run.vars[step.var_name || 'answer'] = value;
    }
}

/*
 * play_step(run, step, resume) -> true to go on; resume: the saved run when this step's
 * action already happened on the previous page
 */
async function play_step(run, step, resume) {
    const title = step_title(step, run.step);
    let url_before = location.href;
    if (resume !== null) {
        url_before = resume.url_before;
    } else {
        if (!(await gate_online(run))) {
            return false;
        }
        if (!(await run_checks(run, step.before, run.last_url, 'before'))) {
            return false;
        }
        url_before = location.href;
        for (let r = 0; r < Math.max(1, step.repeat); r++) {
            await save_run_state(saved(run, { phase: 'after', url_before: url_before }));
            const times = step.repeat > 1 ? ` (${r + 1} of ${step.repeat})` : '';
            set_phase(run, 'action', `${title}: ${describe_action(step)}${times}`);
            await perform(run, step);
            if (run.stopped) {
                return false;
            }
            if (r < step.repeat - 1 && !(await sleep(run, with_jitter(step.repeat_pause_ms, step.jitter_ms), ticker(run)))) {
                return false;
            }
        }
    }
    if (!(await run_checks(run, step.after, url_before, 'after'))) {
        return false;
    }
    run.last_url = url_before;
    return true;
}

/*
 * is_last(run, index) -> true if index is the last enabled step of the last loop
 */
function is_last(run, index) {
    const steps = run.activity.steps;
    for (let i = index + 1; i < steps.length; i++) {
        if (steps[i].enabled) {
            return false;
        }
    }
    return run.activity.loops !== 0 && run.loop >= run.activity.loops - 1;
}

/*
 * play(run, resume) -> Promise; the whole run, from run.step / run.loop
 */
async function play(run, resume) {
    const steps = run.activity.steps;
    let pending = resume;
    while (run.activity.loops === 0 || run.loop < run.activity.loops) {
        for (; run.step < steps.length; run.step++) {
            const step = steps[run.step];
            if (!step.enabled) {
                continue;
            }
            if (!(await play_step(run, step, pending))) {
                return;
            }
            pending = null;
            if (!is_last(run, run.step)) {
                set_phase(run, 'pause', `${step_title(step, run.step)} done — pausing`);
                if (!(await sleep(run, with_jitter(step.pause_ms, step.jitter_ms), ticker(run)))) {
                    return;
                }
            }
        }
        run.step = 0;
        run.loop++;
        if (run.activity.loops === 0 || run.loop < run.activity.loops) {
            set_phase(run, 'pause', `Loop ${run.loop} done — next loop`);
            if (!(await sleep(run, run.activity.loop_pause_ms, ticker(run)))) {
                return;
            }
        }
    }
}

/*
 * finish_job(run) — tell the activity that opened this page how the run went
 */
function finish_job(run) {
    if (run.job === null) {
        return;
    }
    let status = 'done';
    if (run.error !== '') {
        status = 'failed';
    } else if (run.stopped) {
        status = 'stopped';
    }
    save_job(run.job.id, { status: status, vars: run.vars, error: run.error });
}

/*
 * start_run(activity, opts) -> Promise<struct run> once it ends;
 *   opts: { step, loop, resume: struct saved_run | null, vars, job: struct job | null, switched }
 */
async function start_run(activity, opts) {
    const o = opts || {};
    if (current_run !== null && !current_run.stopped && current_run.phase !== 'done') {
        stop_run();
    }
    const run = {
        activity: clone(activity), stopped: false, step: o.step || 0, loop: o.loop || 0,
        phase: 'before', text: 'Starting…', left_ms: 0, last_url: location.href, error: '',
        vars: Object.assign({}, o.vars || {}), job: o.job || null, side_id: null, switched: !!o.switched,
    };
    current_run = run;
    notify(run);
    try {
        if (o.resume === undefined || o.resume === null) {
            if ((await ensure_device(run)) === 'reloading') {
                return run;
            }
        }
        await play(run, o.resume || null);
    } catch (e) {
        run.error = `${step_title(run.activity.steps[run.step] || {}, run.step)}: ${e.message}`;
    }
    await save_run_state(null);
    finish_job(run);
    if (run.error !== '') {
        set_phase(run, 'failed', run.error);
    } else if (run.stopped) {
        set_phase(run, 'stopped', 'Stopped');
    } else {
        set_phase(run, 'done', `Finished "${run.activity.name}"`);
    }
    return run;
}

/*
 * stop_run() — stop the current run (it notices within 100 ms)
 */
function stop_run() {
    if (current_run !== null) {
        current_run.stopped = true;
        if (current_run.side_id !== null) {
            GM_split.close(current_run.side_id).catch(function () {});
        }
        notify(current_run);
    }
    save_run_state(null);
}

/*
 * is_running() -> true while a run is playing
 */
function is_running() {
    return current_run !== null && !current_run.stopped && ['before', 'action', 'after', 'pause'].indexOf(current_run.phase) >= 0;
}

/*
 * test_step(step, activity) -> Promise of the values the step read; does one step's
 *   action right now, without its checks
 */
async function test_step(step, activity) {
    const run = { activity: activity, stopped: false, vars: {}, side_id: null, left_ms: 0 };
    await perform(run, step);
    return run.vars;
}

/*
 * resume_saved_run() -> Promise; carry on with a run a page load interrupted
 */
async function resume_saved_run() {
    const saved = await load_run_state();
    if (saved === null) {
        return null;
    }
    const activity = load_activity(saved.activity_id);
    if (activity === null || saved.step >= activity.steps.length) {
        await save_run_state(null);
        return null;
    }
    const resume = saved.phase === 'after' ? saved : null;
    return start_run(activity, { step: saved.step, loop: saved.loop, resume: resume, vars: saved.vars, job: saved.job || null, switched: saved.phase === 'start' });
}

/*
 * start_job() -> Promise<struct run | null>; in a page another activity opened beside
 *   itself, play the activity it asked for (once: a reload doesn't start it again)
 */
async function start_job() {
    if (typeof GM_split === 'undefined') {
        return null;
    }
    const info = await GM_split.data();
    const job = info !== null && info.data !== null && typeof info.data === 'object' ? info.data.followme_job : undefined;
    if (job === undefined) {
        return null;
    }
    const result = load_job(job.id);
    if (result === null || result.status !== 'running' || result.started) {
        return null;
    }
    const activity = load_activity(job.activity_id);
    if (activity === null) {
        save_job(job.id, { status: 'failed', error: 'its activity was deleted' });
        return null;
    }
    save_job(job.id, { status: 'running', started: true });
    toast(`followMe: playing "${activity.name}" for "${job.opener}"`);
    return start_run(activity, { vars: job.vars, job: { id: job.id, activity_id: job.activity_id, opener: job.opener } });
}

// ---------- src/ui/styles.js ----------

/*
 * followMe's styles, one string per layer. BASE_CSS (colours, buttons, fields) goes
 * into every layer; light and dark follow the system.
 */

const BASE_CSS = `
:host { all: initial; }
* { box-sizing: border-box; }
.fm {
  --bg: #ffffff; --bg2: #f4f6f9; --fg: #1d232b; --muted: #6a7480; --line: #dfe4ea;
  --accent: #e8590c; --accent-fg: #fff; --accent-soft: #fff0e6; --ok: #2f9e44; --bad: #e03131;
  --mark: #e8590c; --shadow: 0 10px 30px rgba(0,0,0,.18);
  font: 13px/1.45 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif; color: var(--fg);
}
@media (prefers-color-scheme: dark) {
  .fm { --bg: #1b1f24; --bg2: #23282f; --fg: #e6e9ee; --muted: #9aa4b0; --line: #343b44;
    --accent: #ff8a3d; --accent-fg: #1b1f24; --accent-soft: #3a2a1e; --shadow: 0 10px 30px rgba(0,0,0,.5); }
}
button { font: inherit; color: inherit; cursor: pointer; }
.btn { border: 1px solid var(--line); background: var(--bg); border-radius: 7px; padding: 5px 10px; }
.btn:hover { background: var(--bg2); }
.btn.primary { background: var(--accent); border-color: var(--accent); color: var(--accent-fg); font-weight: 600; }
.btn.danger { color: var(--bad); }
.btn.ghost { border-color: transparent; background: transparent; }
.btn.small { padding: 2px 7px; font-size: 12px; }
.btn:disabled { opacity: .45; cursor: default; }
input, select { font: inherit; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 4px 7px; min-width: 0; }
input[type=number] { width: 62px; }
input.secs { width: 58px; }
input[type=checkbox] { width: auto; accent-color: var(--accent); }
.muted { color: var(--muted); }
.row { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; }
.grow { flex: 1; }
.badge { display: inline-flex; align-items: center; justify-content: center; min-width: 22px; height: 22px; padding: 0 6px;
  border-radius: 11px; background: var(--mark); color: #fff; font-weight: 700; font-size: 12px; }
`;

const PANEL_CSS = `
.panel { position: fixed; top: 0; bottom: 0; width: 370px; max-width: 100vw; background: var(--bg); border-left: 1px solid var(--line);
  box-shadow: var(--shadow); display: flex; flex-direction: column; }
.panel.right { right: 0; } .panel.left { left: 0; border-left: 0; border-right: 1px solid var(--line); }
/* A phone-sized window (or a tab shown as a phone): the panel becomes a sheet at the bottom. */
@media (max-width: 600px) {
  .panel, .panel.left, .panel.right { left: 0; right: 0; top: auto; width: auto; height: 55vh; border: 0; border-top: 1px solid var(--line); border-radius: 12px 12px 0 0; }
}
.unsaved { margin-left: 6px; font-size: 10px; font-weight: 700; text-transform: uppercase; letter-spacing: .04em; color: var(--accent); }
.note { padding: 6px 8px; border-radius: 6px; background: var(--bg2); } .note.bad { color: var(--bad); }
.howto { margin: 0; padding-left: 18px; } .howto a { color: var(--accent); }
a.btn { text-decoration: none; color: inherit; display: inline-block; }
/* In Chrome's side panel: fill it (and never become the phone-width bottom sheet). */
.panel.in-side, .panel.in-side.left, .panel.in-side.right { position: fixed !important; inset: 0 !important; width: auto !important;
  height: auto !important; max-width: none !important; border: 0 !important; border-radius: 0 !important; box-shadow: none !important; }
.net { border: 0; background: transparent; font-size: 11px; color: var(--muted); padding: 2px 4px; display: inline-flex; align-items: center; gap: 4px; white-space: nowrap; }
.net::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--muted); }
.net.on::before { background: var(--ok); } .net.off { color: var(--bad); } .net.off::before { background: var(--bad); }
.head { display: flex; align-items: center; gap: 8px; padding: 10px 12px; border-bottom: 1px solid var(--line); }
.logo { font-weight: 800; letter-spacing: -.02em; font-size: 15px; } .logo b { color: var(--accent); }
.site { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.body { flex: 1; overflow: auto; padding: 12px; display: flex; flex-direction: column; gap: 10px; }
.foot { border-top: 1px solid var(--line); padding: 8px 12px; display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
.status { padding: 8px 12px; border-top: 1px solid var(--line); background: var(--accent-soft); font-size: 12px; display: flex; gap: 8px; align-items: center; }
.status.done { background: var(--bg2); } .status.failed { background: #ffe3e3; color: #a51d1d; }
@media (prefers-color-scheme: dark) { .status.failed { background: #3b1e1e; color: #ffb3b3; } }
.status .text { flex: 1; }
.status[hidden] { display: none; }
.card { border: 1px solid var(--line); border-radius: 10px; padding: 10px; background: var(--bg); }
.card.clickable { cursor: pointer; } .card.clickable:hover { border-color: var(--accent); }
.card h3 { margin: 0; font-size: 14px; }
.empty { text-align: center; color: var(--muted); padding: 24px 8px; }
.empty b { color: var(--fg); }
.name { font-weight: 600; font-size: 15px; border-color: transparent; width: 100%; padding: 3px 6px; }
.name:hover, .name:focus { border-color: var(--line); }
.steps { display: flex; flex-direction: column; gap: 8px; }
.step { border: 1px solid var(--line); border-radius: 10px; background: var(--bg); }
.step.current { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent-soft); }
.step.off { opacity: .55; }
.step-head { display: flex; gap: 8px; align-items: center; padding: 8px 10px; cursor: pointer; }
.step-head .what { flex: 1; min-width: 0; }
.step-head .title { font-weight: 600; }
.step-head .desc { color: var(--muted); font-size: 12px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.step-body { border-top: 1px solid var(--line); padding: 10px; display: flex; flex-direction: column; gap: 10px; background: var(--bg2); border-radius: 0 0 10px 10px; }
.section > .label { font-size: 11px; text-transform: uppercase; letter-spacing: .06em; color: var(--muted); font-weight: 700; margin-bottom: 4px; }
.screen { position: relative; width: 120px; height: 76px; border: 1px solid var(--line); border-radius: 5px; background: var(--bg); flex: none; }
.screen.tiny { width: 40px; height: 26px; border-radius: 3px; }
.screen .dot { position: absolute; width: 8px; height: 8px; margin: -4px 0 0 -4px; border-radius: 50%; background: var(--mark); }
.screen.tiny .dot { width: 5px; height: 5px; margin: -2.5px 0 0 -2.5px; }
.check { display: flex; gap: 6px; align-items: center; flex-wrap: wrap; padding: 6px 8px; border: 1px dashed var(--line); border-radius: 8px; background: var(--bg); }
.check .kind { font-weight: 600; flex: 1; min-width: 120px; }
.how { font-size: 12px; color: var(--muted); }
.hits { font-size: 12px; } .hits code { font: 12px ui-monospace, monospace; background: var(--bg); padding: 1px 4px; border-radius: 4px; }
.flow { color: var(--muted); font-size: 12px; text-align: center; }
textarea { font: 12px ui-monospace, monospace; width: 100%; min-height: 160px; color: var(--fg); background: var(--bg); border: 1px solid var(--line); border-radius: 6px; padding: 6px; }
`;

const TAB_CSS = `
.tab { position: fixed; width: 30px; height: 64px; background: var(--accent); color: var(--accent-fg); border: 0; box-shadow: var(--shadow);
  font-weight: 800; font-size: 12px; writing-mode: vertical-rl; display: flex; align-items: center; justify-content: center; opacity: .85; }
.tab:hover { opacity: 1; }
.tab.right { right: 0; border-radius: 10px 0 0 10px; } .tab.left { left: 0; border-radius: 0 10px 10px 0; }
.tab.running { animation: fm-pulse 1s infinite; }
@keyframes fm-pulse { 50% { opacity: .5; } }
`;

const MARKS_CSS = `
.marks { position: fixed; inset: 0; pointer-events: none; }
.marks svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
.marks line { stroke: var(--mark); stroke-width: 2; stroke-dasharray: 5 5; opacity: .6; }
.mark { position: absolute; width: 30px; height: 30px; margin: -15px 0 0 -15px; border-radius: 50%; pointer-events: auto; cursor: grab;
  background: rgba(232, 89, 12, .22); border: 2px solid var(--mark); display: flex; align-items: center; justify-content: center;
  color: #fff; font: 700 12px system-ui, sans-serif; text-shadow: 0 0 3px #000, 0 0 2px #000; user-select: none; touch-action: none; }
.mark::after { content: ""; position: absolute; width: 4px; height: 4px; border-radius: 50%; background: var(--mark); left: 11px; top: 11px; }
.mark span { position: absolute; top: -18px; left: 50%; transform: translateX(-50%); background: var(--mark); border-radius: 9px; padding: 0 6px;
  font-size: 11px; line-height: 16px; text-shadow: none; white-space: nowrap; }
.mark.selected { border-width: 3px; background: rgba(232, 89, 12, .38); }
.mark.active { animation: fm-ping .8s infinite; }
.mark.off { opacity: .35; }
.mark.dragging { cursor: grabbing; }
@keyframes fm-ping { 0% { box-shadow: 0 0 0 0 rgba(232, 89, 12, .7); } 100% { box-shadow: 0 0 0 16px rgba(232, 89, 12, 0); } }
`;

const PICKER_CSS = `
.picker { position: fixed; inset: 0; cursor: crosshair; background: rgba(0, 0, 0, .04); }
.hline, .vline { position: absolute; background: var(--mark); opacity: .6; pointer-events: none; }
.hline { left: 0; right: 0; height: 1px; } .vline { top: 0; bottom: 0; width: 1px; }
.info { position: absolute; pointer-events: none; background: var(--bg); color: var(--fg); border: 1px solid var(--line); box-shadow: var(--shadow);
  border-radius: 8px; padding: 6px 9px; font-size: 12px; max-width: 320px; }
.info b { color: var(--accent); }
.banner { position: absolute; top: 12px; left: 50%; transform: translateX(-50%); background: var(--fg); color: var(--bg); border-radius: 20px;
  padding: 7px 14px; font-weight: 600; pointer-events: none; box-shadow: var(--shadow); }
`;

// ---------- src/ui/dom.js ----------

/*
 * Building followMe's own elements. Each layer (panel, edge tab, marks, picker) is a
 * host element on top of the page with a closed shadow root, so the page's CSS can't
 * restyle it and the page's scripts can't reach into it.
 *
 * struct layer { host: HTMLElement; root: ShadowRoot }
 */

/*
 * append_all(el, children) — append nodes and strings, skipping null/false, flattening arrays
 */
function append_all(el, children) {
    for (const child of children) {
        if (child === null || child === undefined || child === false) {
            continue;
        }
        if (Array.isArray(child)) {
            append_all(el, child);
        } else {
            el.append(child);
        }
    }
}

/*
 * h(tag, props, ...children) -> a new element
 *   props: class, on_<event> handlers, attributes, properties
 */
function h(tag, props) {
    const el = document.createElement(tag);
    const p = props || {};
    for (const key of Object.keys(p)) {
        const value = p[key];
        if (value === null || value === undefined || value === false) {
            continue;
        }
        if (key.startsWith('on_')) {
            el.addEventListener(key.slice(3), value);
        } else if (key === 'class') {
            el.className = value;
        } else if (key === 'style' && typeof value === 'object') {
            Object.assign(el.style, value);
        } else if (key in el && typeof value !== 'string') {
            el[key] = value;
        } else {
            el.setAttribute(key, value === true ? '' : value);
        }
    }
    append_all(el, Array.prototype.slice.call(arguments, 2));
    return el;
}

/*
 * layer_create(name, css) -> struct layer: a fixed, topmost host with its own styles
 */
function layer_create(name, css) {
    const host = document.createElement('div');
    host.setAttribute('data-followme', name);
    host.style.cssText = 'all: initial; position: fixed; z-index: 2147483647; top: 0; left: 0; width: 0; height: 0;';
    const root = host.attachShadow({ mode: 'closed' });
    root.append(h('style', null, BASE_CSS + css));
    document.documentElement.append(host);
    register_layer(host);
    return { host: host, root: root };
}

/*
 * layer_remove(layer) — take a layer off the page
 */
function layer_remove(layer) {
    unregister_layer(layer.host);
    layer.host.remove();
}

/*
 * number_field(value, on_change, attrs) -> an <input type=number> that reports numbers
 */
function number_field(value, on_change, attrs) {
    return h('input', Object.assign({
        type: 'number',
        value: String(value),
        on_change: function (event) {
            on_change(to_number(event.target.value, value));
        },
    }, attrs || {}));
}

/*
 * text_field(value, on_change, attrs) -> an <input> that reports its text on change
 */
function text_field(value, on_change, attrs) {
    return h('input', Object.assign({
        type: 'text',
        value: value,
        spellcheck: 'false',
        on_change: function (event) {
            on_change(event.target.value);
        },
    }, attrs || {}));
}

/*
 * select_field(value, options, on_change) -> a <select>; options: { value: label }
 */
function select_field(value, options, on_change) {
    const items = [];
    for (const key of Object.keys(options)) {
        items.push(h('option', { value: key, selected: key === value }, options[key]));
    }
    return h('select', {
        on_change: function (event) {
            on_change(event.target.value);
        },
    }, items);
}

/*
 * seconds_field(ms, on_change) -> a number field in seconds that reports milliseconds
 */
function seconds_field(ms, on_change) {
    return number_field(Math.round(ms) / 1000, function (s) {
        on_change(Math.max(0, Math.round(s * 1000)));
    }, { step: '0.1', min: '0', class: 'secs' });
}

// ---------- src/ui/picker.js ----------

/*
 * Marking a pixel: a see-through layer over the whole page with a crosshair that
 * follows the pointer and shows the coordinates and what is under them. A click there
 * marks the point (the page itself is not clicked); Esc cancels.
 */

let picking = null;   // the open picker's finish function, or null

/*
 * pick_point(number) -> Promise<{ x, y } | null>; number is shown as "Click <number>"
 */
function pick_point(number) {
    if (picking !== null) {
        picking(null);
    }
    return new Promise(function (resolve) {
        const layer = layer_create('picker', PICKER_CSS);
        const hline = h('div', { class: 'hline' });
        const vline = h('div', { class: 'vline' });
        const info = h('div', { class: 'info' }, 'Move to the spot');
        const overlay = h('div', { class: 'picker' }, hline, vline, info,
            h('div', { class: 'banner' }, `Click where Click ${number} should go · Esc to cancel`));
        layer.root.append(h('div', { class: 'fm' }, overlay));

        /*
         * finish(point) — close the picker and answer
         */
        function finish(point) {
            picking = null;
            if (frame !== 0) {
                cancelAnimationFrame(frame);
            }
            document.removeEventListener('keydown', on_key, true);
            layer_remove(layer);
            resolve(point);
        }

        /*
         * on_key(event) — Esc cancels
         */
        function on_key(event) {
            if (event.key === 'Escape') {
                event.preventDefault();
                event.stopPropagation();
                finish(null);
            }
        }

        let frame = 0;
        let last = null;

        /*
         * follow() — move the crosshair to the last pointer position, once per frame
         */
        function follow() {
            frame = 0;
            const x = last.clientX;
            const y = last.clientY;
            hline.style.top = `${y}px`;
            vline.style.left = `${x}px`;
            const hit = hit_at(x, y);   // the picker layer itself is skipped
            info.replaceChildren(h('b', null, `(${Math.round(x)}, ${Math.round(y)})`), ' ', describe_target(hit === null ? null : hit.el));
            const right = x + 340 > window.innerWidth;
            info.style.left = right ? '' : `${x + 14}px`;
            info.style.right = right ? `${window.innerWidth - x + 14}px` : '';
            info.style.top = `${Math.min(y + 14, window.innerHeight - 50)}px`;
        }

        overlay.addEventListener('pointermove', function (event) {
            last = event;
            if (frame === 0) {
                frame = requestAnimationFrame(follow);
            }
        });
        overlay.addEventListener('click', function (event) {
            event.preventDefault();
            event.stopPropagation();
            finish({ x: event.clientX, y: event.clientY });
        });
        overlay.addEventListener('contextmenu', function (event) {
            event.preventDefault();
            finish(null);
        });
        document.addEventListener('keydown', on_key, true);
        picking = finish;
    });
}

// ---------- src/ui/marks.js ----------

/*
 * The numbered marks: one circle per step at the pixel it acts on, joined by a dashed
 * line in play order, like an auto-tapper's targets. Drag a mark to move its step.
 * The playing step pulses.
 *
 * struct marks (one, below) {
 *     layer: struct layer | null;
 *     activity: struct activity | null;   shown, or null for none
 *     selected: number;                   step open in the panel, or -1
 *     active: number;                     step being played, or -1
 *     on_move(index, x, y);               a mark was dragged to (x, y)
 *     frame: number;                      pending animation frame, or 0
 *     drawn: string;                      what is on screen, to skip redrawing the same
 * }
 */

const marks = { layer: null, activity: null, selected: -1, active: -1, on_move: null, frame: 0, drawn: '' };

/*
 * marks_set(activity, selected, on_move) — show these marks (activity null hides them)
 */
function marks_set(activity, selected, on_move) {
    marks.activity = activity;
    marks.selected = selected;
    marks.on_move = on_move;
    marks_render();
}

/*
 * marks_active(index) — highlight the step being played (-1: none)
 */
function marks_active(index) {
    if (marks.active !== index) {
        marks.active = index;
        marks_render();
    }
}

/*
 * marks_render_soon() — redraw once before the next frame (scrolling, resizing)
 */
function marks_render_soon() {
    if (marks.frame === 0 && marks.activity !== null) {
        marks.frame = requestAnimationFrame(function () {
            marks.frame = 0;
            marks_render();
        });
    }
}

/*
 * drag_mark(el, index, event) — move a mark with the pointer, then report where it landed
 */
function drag_mark(el, index, event) {
    event.preventDefault();
    event.stopPropagation();
    el.setPointerCapture(event.pointerId);
    el.classList.add('dragging');

    /*
     * on_move(e) — follow the pointer
     */
    function on_move(e) {
        el.style.left = `${e.clientX}px`;
        el.style.top = `${e.clientY}px`;
    }

    /*
     * on_up(e) — drop the mark
     */
    function on_up(e) {
        el.removeEventListener('pointermove', on_move);
        el.removeEventListener('pointerup', on_up);
        el.classList.remove('dragging');
        if (marks.on_move !== null) {
            marks.on_move(index, e.clientX, e.clientY);
        }
    }
    el.addEventListener('pointermove', on_move);
    el.addEventListener('pointerup', on_up);
}

/*
 * marks_render() — draw the marks of the shown activity
 */
function marks_render() {
    if (marks.activity === null) {
        if (marks.layer !== null) {
            layer_remove(marks.layer);
            marks.layer = null;
        }
        return;
    }
    const view = view_now();
    // The same marks in the same place: leave them (no flicker, the pulse keeps going).
    const key = JSON.stringify([marks.activity.steps, marks.selected, marks.active, view]);
    if (marks.layer !== null && key === marks.drawn) {
        return;
    }
    marks.drawn = key;
    if (marks.layer === null) {
        marks.layer = layer_create('marks', MARKS_CSS);
    }
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    const dots = [];
    let prev = null;
    const steps = marks.activity.steps;
    for (let i = 0; i < steps.length; i++) {
        const step = steps[i];
        if (!step_has_point(step)) {
            continue;
        }
        const p = point_of(step);
        if (prev !== null && step.enabled) {
            const line = document.createElementNS('http://www.w3.org/2000/svg', 'line');
            line.setAttribute('x1', prev.x);
            line.setAttribute('y1', prev.y);
            line.setAttribute('x2', p.x);
            line.setAttribute('y2', p.y);
            svg.append(line);
        }
        if (step.enabled) {
            prev = p;
        }
        let cls = 'mark';
        if (i === marks.selected) {
            cls += ' selected';
        }
        if (i === marks.active) {
            cls += ' active';
        }
        if (!step.enabled) {
            cls += ' off';
        }
        const index = i;
        const dot = h('div', {
            class: cls,
            title: `${step_title(step, i)}: ${describe_action(step)} — drag to move`,
            style: { left: `${p.x}px`, top: `${p.y}px` },
            on_pointerdown: function (event) {
                drag_mark(dot, index, event);
            },
        }, String(i + 1), h('span', null, step_title(step, i)));
        dots.push(dot);
    }
    marks.layer.root.replaceChildren(h('style', null, BASE_CSS + MARKS_CSS), h('div', { class: 'fm marks' }, svg, dots));
}

window.addEventListener('scroll', marks_render_soon, { passive: true });
window.addEventListener('resize', marks_render_soon);

// ---------- src/ui/panel.js ----------

/*
 * The side panel. Two views:
 *   list    — this site's activities: play one, open one, make a new one
 *   detail  — one activity: its steps in order. Each step opens to show where it acts
 *             on the screen (a small map of the window, the pixel, what is there right
 *             now), what it does, how it does it, what it waits for before and after,
 *             and the break before the next step.
 * Plus 'transfer', for exporting and importing activities as JSON, and 'sync', for the
 * GitHub gist that keeps them all.
 *
 * Every change is kept at once (nothing is lost if you forget to save). A step changed
 * since the last Save shows "unsaved"; Save marks it saved and updates the gist.
 *
 * struct panel (one, below) {
 *     layer: struct layer | null;
 *     view: 'list' | 'detail' | 'transfer' | 'sync';
 *     activity: struct activity | null;   the one open in 'detail'
 *     open_step: number;                  step whose details are shown, or -1
 *     prefs: struct prefs;
 *     status: HTMLElement | null;         the run status bar
 *     rows: HTMLElement[];                step rows, to mark the playing one
 *     hidden: boolean;                    hidden while marking a point
 *     net: HTMLElement | null;            the "online / offline" light in the header
 *     cloud: HTMLElement | null;          the gist button in the footer
 *     side: GM_sidePanel handle | null;   mirroring the panel into Chrome's side panel
 *     side_shown: boolean;                the side panel shows it (the page doesn't)
 * }
 *
 * Pinned (prefs.pinned), the panel is drawn the same way but shown in Chrome's side
 * panel through Moss (GM_sidePanel): next to the page instead of over it, and full size
 * even while the tab is shown as a phone. Its clicks come back here and run as usual.
 */

const panel = {
    layer: null, view: 'list', activity: null, open_step: -1, prefs: null, status: null, rows: [], hidden: false, net: null, cloud: null,
    side: null, side_shown: false,
};

// ---------- opening and closing ----------

/*
 * panel_open() — show the panel
 */
function panel_open() {
    panel.prefs.open = true;
    save_prefs(panel.prefs);
    panel_render();
    tab_render();
}

/*
 * panel_close() — hide the panel (and the marks, unless a run is playing)
 */
function panel_close() {
    if (panel.side_shown) {
        unpin();
        return;
    }
    panel.prefs.open = false;
    save_prefs(panel.prefs);
    if (panel.layer !== null) {
        layer_remove(panel.layer);
        panel.layer = null;
    }
    if (!is_running()) {
        marks_set(null, -1, null);
    }
    tab_render();
}

/*
 * panel_toggle() — open or close
 */
function panel_toggle() {
    if (panel.prefs.open) {
        panel_close();
    } else {
        panel_open();
    }
}

/*
 * panel_visible() -> true if the panel is to be drawn (in the page or the side panel)
 */
function panel_visible() {
    return panel.prefs.open || panel.side_shown;
}

// ---------- the side panel ----------

/*
 * side_start() — offer the panel to Moss's side panel (shown once that is open)
 */
function side_start() {
    if (panel.side === null && typeof GM_sidePanel !== 'undefined') {
        panel.side = GM_sidePanel.mirror(panel.layer === null ? null : panel.layer.root, { title: 'followMe', on_show: side_on_show });
    }
}

/*
 * side_on_show(shown) — the side panel started or stopped showing the panel
 */
function side_on_show(shown) {
    panel.side_shown = shown;
    if (shown) {
        panel_render();
    } else if (panel.layer !== null) {
        if (panel.prefs.open) {
            panel_render();
        } else {
            layer_remove(panel.layer);
            panel.layer = null;
        }
    }
    tab_render();
}

/*
 * pin() — move the panel into Chrome's side panel
 */
function pin() {
    if (typeof GM_sidePanel === 'undefined') {
        toast('Pinning needs a Moss with the side panel (Moss 0.2+).', { type: 'error' });
        return;
    }
    panel.prefs.pinned = true;
    save_prefs(panel.prefs);
    side_start();
    panel.side.open().then(function () {
        toast('Pinned: followMe is in the side panel');
    }, function (e) {
        toast(`Pinned. ${e.message}`, { type: 'error', timeout: 9000 });
    });
}

/*
 * unpin() — back into the page
 */
function unpin() {
    panel.prefs.pinned = false;
    panel.prefs.open = true;
    save_prefs(panel.prefs);
    if (panel.side !== null) {
        const side = panel.side;
        panel.side = null;
        side.close().catch(function () {}).then(function () {
            return side.stop();
        }).catch(function () {});
    }
    panel.side_shown = false;
    panel_render();
    tab_render();
}

// ---------- editing the open activity ----------

/*
 * commit(change, rerender) — change the open activity, store it, redraw the marks and,
 * when rerender, the panel
 */
function commit(change, rerender) {
    change(panel.activity);
    panel.activity = save_activity(panel.activity);
    show_marks();
    if (rerender) {
        panel_render();
    }
}

/*
 * edit_step(index, change, rerender) — commit a change to one step
 */
function edit_step(index, change, rerender) {
    commit(function (activity) {
        change(activity.steps[index]);
        mark_unsaved(activity, activity.steps[index].id);
    }, rerender);
}

/*
 * edit_settings(change, rerender) — commit a change to the activity's own settings
 */
function edit_settings(change, rerender) {
    commit(function (activity) {
        change(activity);
        mark_unsaved(activity, '');
    }, rerender);
}

/*
 * mark_unsaved(activity, id) — note that a step ('' = the settings) changed since Save
 */
function mark_unsaved(activity, id) {
    if (activity.unsaved.indexOf(id) < 0) {
        activity.unsaved.push(id);
    }
}

/*
 * save_now() — Save: everything in the open activity counts as saved, and the gist is
 *   updated
 */
function save_now() {
    commit(function (activity) {
        activity.unsaved = [];
    }, true);
    if (!gist_ready()) {
        toast('Saved. (Connect a GitHub gist under ☁ Gist to keep a backup there too.)');
        return;
    }
    toast('Saved — updating the gist…');
    gist_sync().then(function () {
        toast('Saved and synced to the gist');
    }, function (e) {
        toast(`Saved here, but the gist sync failed: ${e.message}`, { type: 'error' });
    });
}

/*
 * steps_changed() — a step was added or removed: keep it, and update the gist
 */
function steps_changed() {
    gist_sync_soon();
}

/*
 * show_marks() — marks for the open activity, if the user wants them
 */
function show_marks() {
    if (panel.view === 'detail' && panel.activity !== null && panel.prefs.show_marks && !panel.hidden) {
        marks_set(panel.activity, panel.open_step, move_step_to);
    } else if (!is_running()) {
        marks_set(null, -1, null);
    }
}

/*
 * move_step_to(index, x, y) — a mark was dragged: the step now acts there
 */
function move_step_to(index, x, y) {
    edit_step(index, function (step) {
        set_point(step, x, y);
    }, true);
}

/*
 * with_panel_hidden(task) -> Promise of task(); the panel steps aside while you mark a point
 */
async function with_panel_hidden(task) {
    panel.hidden = true;
    if (panel.layer !== null) {
        panel.layer.host.style.display = 'none';
    }
    try {
        return await task();
    } finally {
        panel.hidden = false;
        if (panel.layer !== null) {
            panel.layer.host.style.display = panel.side_shown ? 'none' : '';
        }
    }
}

/*
 * add_point_step(action) — mark a pixel and add a step there (after the open step, or
 *   last); action: 'click' when left out
 */
async function add_point_step(action) {
    const at = panel.open_step >= 0 ? panel.open_step + 1 : panel.activity.steps.length;
    const point = await with_panel_hidden(function () {
        return pick_point(at + 1);
    });
    if (point === null) {
        show_marks();
        return;
    }
    const step = step_create(point.x, point.y, view_now());
    set_point(step, point.x, point.y);
    if (typeof action === 'string') {
        step.action = action;
    }
    commit(function (activity) {
        activity.steps.splice(at, 0, step);
    }, false);
    steps_changed();
    panel.open_step = at;
    panel_render();
    if (step.action === 'type') {
        focus_type_text();
    }
}

/*
 * add_type_step() — add "type text": into the field the step before clicks, or, when
 *   there is no click before it, into a field you mark on the page
 */
function add_type_step() {
    const at = panel.open_step >= 0 ? panel.open_step + 1 : panel.activity.steps.length;
    const before = at > 0 ? panel.activity.steps[at - 1] : null;
    if (before === null || before.action !== 'click') {
        add_point_step('type');
        return;
    }
    const step = step_create(0, 0, view_now());
    step.action = 'type';
    step.type_into = 'focused';
    step.pause_ms = 500;
    commit(function (activity) {
        activity.steps.splice(at, 0, step);
    }, false);
    steps_changed();
    panel.open_step = at;
    panel_render();
    focus_type_text();
}

/*
 * focus_type_text() — put the cursor in the open step's "Text to type" box
 */
function focus_type_text() {
    if (panel.layer === null) {
        return;
    }
    const box = panel.layer.root.querySelector('.step-body input[placeholder="Text to type"]');
    if (box !== null) {
        box.focus();
    }
}

/*
 * add_other_step(action) — add a step that needs no point ('wait', 'key' or 'side')
 */
function add_other_step(action) {
    const at = panel.open_step >= 0 ? panel.open_step + 1 : panel.activity.steps.length;
    const step = step_create(0, 0, view_now());
    step.action = action;
    commit(function (activity) {
        activity.steps.splice(at, 0, step);
    }, false);
    steps_changed();
    panel.open_step = at;
    panel_render();
}

/*
 * remark_step(index) — mark a new pixel for an existing step
 */
async function remark_step(index) {
    const point = await with_panel_hidden(function () {
        return pick_point(index + 1);
    });
    if (point !== null) {
        move_step_to(index, point.x, point.y);
    } else {
        show_marks();
    }
}

/*
 * move_step(index, by) — move a step up (-1) or down (+1)
 */
function move_step(index, by) {
    const to = index + by;
    if (to < 0 || to >= panel.activity.steps.length) {
        return;
    }
    commit(function (activity) {
        const step = activity.steps.splice(index, 1)[0];
        activity.steps.splice(to, 0, step);
    }, false);
    panel.open_step = panel.open_step === index ? to : panel.open_step;
    panel_render();
}

/*
 * open_activity(activity) — show one activity in detail
 */
function open_activity(activity) {
    panel.activity = activity;
    panel.view = 'detail';
    panel.open_step = -1;
    panel.prefs.last_activity = activity.id;
    save_prefs(panel.prefs);
    panel_render();
}

/*
 * close_activity() — back to the list
 */
function close_activity() {
    panel.view = 'list';
    panel.activity = null;
    panel.prefs.last_activity = '';
    save_prefs(panel.prefs);
    panel_render();
}

/*
 * switch_device(mode, orientation) — show this tab as that device now (it reloads)
 */
function switch_device(mode, orientation) {
    device_switch(mode, orientation).catch(function (e) {
        toast(e.message, { type: 'error' });
    });
}

/*
 * new_activity() — ask for a name, create it, and start marking its first click
 */
function new_activity() {
    const name = prompt('Name of the new activity:', `On ${location.hostname}`);
    if (name === null) {
        return;
    }
    open_activity(save_activity(activity_create(name.trim() || 'Untitled', location.href)));
    add_point_step('click');
}

/*
 * play_activity(activity, from) — play an activity from step index from
 */
function play_activity(activity, from) {
    if (activity.steps.length === 0) {
        toast('Add a click first.');
        return;
    }
    start_run(activity, { step: from || 0 });
}

// ---------- small pieces ----------

/*
 * mini_screen(step, tiny) -> a small picture of the window with the step's pixel on it
 */
function mini_screen(step, tiny) {
    const view = view_now();
    const p = point_of(step);
    const left = clamp(p.x / Math.max(1, view.w), 0, 1) * 100;
    const top = clamp(p.y / Math.max(1, view.h), 0, 1) * 100;
    return h('div', { class: tiny ? 'screen tiny' : 'screen', title: `(${Math.round(p.x)}, ${Math.round(p.y)}) in a ${view.w}×${view.h} window` },
        h('div', { class: 'dot', style: { left: `${left}%`, top: `${top}%` } }));
}

/*
 * step_summary(step) -> one line for a closed step: action, then what it waits for
 */
function step_summary(step) {
    const parts = [describe_action(step)];
    if (step.after.length > 0) {
        parts.push(`then waits: ${step.after.length === 1 ? CHECKS[step.after[0].kind].label.toLowerCase() : `${step.after.length} checks`}`);
    }
    if (step.pause_ms > 0) {
        parts.push(`pause ${format_ms(step.pause_ms)}`);
    }
    return parts.join(' · ');
}

/*
 * render_checks(index, which) -> the "before" or "after" checks of a step, editable
 */
function render_checks(index, which) {
    const step = panel.activity.steps[index];
    const rows = [];
    const checks = step[which];
    for (let c = 0; c < checks.length; c++) {
        const check = checks[c];
        const k = c;
        const value = CHECKS[check.kind].value
            ? (check.kind === 'wait'
                ? seconds_field(to_number(check.value, 0), function (ms) {
                    edit_step(index, function (s) { s[which][k].value = String(ms); }, false);
                })
                : text_field(check.value, function (v) {
                    edit_step(index, function (s) { s[which][k].value = v; }, false);
                }, { placeholder: '*/checkout* or /regex/', class: 'grow' }))
            : null;
        const limits = check.kind === 'wait' ? null : h('span', { class: 'row muted' }, 'max',
            seconds_field(check.timeout_ms, function (ms) {
                edit_step(index, function (s) { s[which][k].timeout_ms = ms; }, false);
            }), 's, then',
            select_field(check.on_timeout, { stop: 'stop', 'continue': 'go on' }, function (v) {
                edit_step(index, function (s) { s[which][k].on_timeout = v; }, false);
            }));
        rows.push(h('div', { class: 'check' },
            h('span', { class: 'kind' }, CHECKS[check.kind].label, check.kind === 'wait' ? null : h('span', { class: 'muted' }, check_now(check, location.href) ? ' · true now' : '')),
            value, limits,
            h('button', {
                class: 'btn ghost small', title: 'Remove this check',
                on_click: function () {
                    edit_step(index, function (s) { s[which].splice(k, 1); }, true);
                },
            }, '✕')));
    }
    const kinds = { '': which === 'before' ? '＋ Wait before…' : '＋ Wait after…' };
    for (const kind of Object.keys(CHECKS)) {
        kinds[kind] = CHECKS[kind].label;
    }
    rows.push(select_field('', kinds, function (kind) {
        if (kind !== '') {
            edit_step(index, function (s) { s[which].push(check_create(kind)); }, true);
        }
    }));
    return rows;
}

/*
 * render_action_fields(index) -> the fields of the step's action (text, key, scroll, hold)
 */
function render_action_fields(index) {
    const step = panel.activity.steps[index];
    const set = function (field, rerender) {
        return function (value) {
            edit_step(index, function (s) { s[field] = value; }, rerender);
        };
    };
    const out = [];
    const check = function (field, label) {
        return h('label', { class: 'row' }, h('input', {
            type: 'checkbox', checked: step[field],
            on_change: function (event) { set(field, true)(event.target.checked); },
        }), label);
    };
    if (step.action === 'type') {
        out.push(h('div', { class: 'row' }, text_field(step.text, set('text', true), { placeholder: 'Text to type', class: 'grow' })),
            h('div', { class: 'row' }, 'Into', select_field(step.type_into, TYPE_INTO, function (v) {
                const view = view_now();
                edit_step(index, function (s) {
                    s.type_into = v;
                    if (v === 'point' && s.x === 0 && s.y === 0) {
                        s.x = Math.round(view.w / 2);
                        s.y = Math.round(view.h / 2);
                    }
                }, true);
            })),
            h('div', { class: 'row' }, 'Type it', select_field(step.type_mode, TYPE_MODES, set('type_mode', true)),
                step.type_mode === 'keys' ? ['every', seconds_field(step.key_delay_ms, set('key_delay_ms', false)), 's'] : null),
            check('clear_first', 'Empty the field first'),
            check('enter_after', 'Press Enter after typing (submits a search box)'));
    } else if (step.action === 'key') {
        out.push(h('div', { class: 'row' }, 'Key', text_field(step.key, set('key', true), { placeholder: 'Enter, Escape, Tab, a…' })));
    } else if (step.action === 'scroll') {
        out.push(h('div', { class: 'row' }, 'Down', number_field(step.scroll_dy, set('scroll_dy', true)), 'px, right',
            number_field(step.scroll_dx, set('scroll_dx', true)), 'px'));
    } else if (step.action === 'long_press') {
        out.push(h('div', { class: 'row' }, 'Hold for', seconds_field(step.hold_ms, set('hold_ms', true)), 's'));
    } else if (step.action === 'read') {
        out.push(h('div', { class: 'row' }, 'Keep it as {', text_field(step.var_name, function (v) {
            set('var_name', true)(v.replace(/[^\w-]/g, '') || 'answer');
        }, { style: { width: '110px' } }), '}'),
        h('div', { class: 'row' }, text_field(step.read_pattern, set('read_pattern', true), {
            placeholder: 'Only part of it: /regex/ (first group), optional', class: 'grow',
        })));
    } else if (step.action === 'side') {
        out.push(render_side_fields(index));
    }
    if (step.action === 'type' || step.action === 'side') {
        out.push(h('div', { class: 'muted' }, 'Write {name} to put in a value a "Read text" step read earlier in the run.'));
    }
    if (step.action !== 'wait' && step.action !== 'side') {
        out.push(h('div', { class: 'row' }, 'Do it', number_field(step.repeat, function (n) {
            set('repeat', true)(clamp(Math.round(n), 1, 1000));
        }, { min: '1' }), 'time(s), every', seconds_field(step.repeat_pause_ms, set('repeat_pause_ms', false)), 's'));
    }
    return out;
}

/*
 * render_side_fields(index) -> the fields of an "other site" step
 */
function render_side_fields(index) {
    const step = panel.activity.steps[index];
    const choices = { '': '— pick an activity —' };
    for (const other of all_activities()) {
        if (other.id !== panel.activity.id) {
            choices[other.id] = `${other.name} (${new URL(other.site).hostname})`;
        }
    }
    const other = step.side_activity === '' ? null : load_activity(step.side_activity);
    return [
        h('div', { class: 'row' }, 'Play', select_field(step.side_activity, choices, function (v) {
            edit_step(index, function (s) { s.side_activity = v; }, true);
        })),
        Object.keys(choices).length === 1
            ? h('div', { class: 'muted' }, 'First make that activity: open the other site, open followMe there and record its steps, ending with a "Read text" step for each answer you need.')
            : null,
        h('div', { class: 'row' }, 'on', text_field(step.side_url, function (v) {
            edit_step(index, function (s) { s.side_url = v.trim(); }, true);
        }, { placeholder: other === null ? 'https://… (page to open)' : other.start_url, class: 'grow', title: 'Page to open; empty = where that activity was made' })),
        h('div', { class: 'row' }, 'In', select_field(step.side_how, SIDE_HOWS, function (v) {
            edit_step(index, function (s) { s.side_how = v; }, false);
        }), select_field(step.side_place, { right: 'on the right', left: 'on the left' }, function (v) {
            edit_step(index, function (s) { s.side_place = v; }, false);
        })),
        h('div', { class: 'row' }, 'Give up after', seconds_field(step.side_timeout_ms, function (ms) {
            edit_step(index, function (s) { s.side_timeout_ms = Math.max(1000, ms); }, false);
        }), 's'),
        h('label', { class: 'row' }, h('input', {
            type: 'checkbox', checked: step.side_close,
            on_change: function (event) {
                edit_step(index, function (s) { s.side_close = event.target.checked; }, false);
            },
        }), 'Close it when done and come back here'),
    ];
}

/*
 * render_step_body(index) -> the open step: where, what, how, waits and pause
 */
function render_step_body(index) {
    const step = panel.activity.steps[index];
    const action_names = {};
    for (const key of Object.keys(ACTIONS)) {
        action_names[key] = ACTIONS[key].label;
    }
    const sections = [];
    if (step_has_point(step)) {
        const now = point_of(step);
        const hit = hit_at(now.x, now.y);
        sections.push(h('div', { class: 'section' },
            h('div', { class: 'label' }, 'Where on the screen'),
            h('div', { class: 'row' }, mini_screen(step, false),
                h('div', { class: 'grow' },
                    h('div', { class: 'row' }, 'x', number_field(Math.round(now.x), function (v) {
                        edit_step(index, function (s) { set_point(s, v, now.y); }, true);
                    }), 'y', number_field(Math.round(now.y), function (v) {
                        edit_step(index, function (s) { set_point(s, now.x, v); }, true);
                    })),
                    h('button', { class: 'btn small', style: { marginTop: '6px' }, on_click: function () { remark_step(index); } }, '📍 Mark again on the page'))),
            h('div', { class: 'row', style: { marginTop: '6px' } }, 'Keeps', select_field(step.place, PLACES, function (v) {
                edit_step(index, function (s) {
                    s.place = v;
                    set_point(s, now.x, now.y); // where it acts now, kept the new way
                }, true);
            })),
            step.place === 'element' ? h('div', { class: 'muted', style: { marginTop: '4px' } }, describe_found(step)) : null,
            h('div', { class: 'hits', style: { marginTop: '6px' } }, 'Right now that pixel is ', h('code', null, describe_target(hit === null ? null : hit.el)),
                h('div', { class: 'muted' }, `Point: ${describe_place(step)}.`))));
    }
    sections.push(h('div', { class: 'section' },
        h('div', { class: 'label' }, 'What it does'),
        h('div', { class: 'row' }, select_field(step.action, action_names, function (v) {
            edit_step(index, function (s) { s.action = v; }, true);
        }), text_field(step.label, function (v) {
            edit_step(index, function (s) { s.label = v.trim(); }, true);
        }, { placeholder: `Name (default "${step_title(Object.assign({}, step, { label: '' }), index)}")`, class: 'grow' })),
        render_action_fields(index)));
    sections.push(h('div', { class: 'section' },
        h('div', { class: 'label' }, 'How'),
        h('div', { class: 'how' }, describe_how(step))));
    sections.push(h('div', { class: 'section' },
        h('div', { class: 'label' }, 'Before it, wait until'),
        render_checks(index, 'before')));
    sections.push(h('div', { class: 'section' },
        h('div', { class: 'label' }, 'After it, wait until'),
        render_checks(index, 'after')));
    sections.push(h('div', { class: 'section' },
        h('div', { class: 'label' }, 'Then pause'),
        h('div', { class: 'row' }, seconds_field(step.pause_ms, function (ms) {
            edit_step(index, function (s) { s.pause_ms = ms; }, true);
        }), 's, give or take', seconds_field(step.jitter_ms, function (ms) {
            edit_step(index, function (s) { s.jitter_ms = ms; }, false);
        }), 's at random')));
    sections.push(h('div', { class: 'row' },
        h('button', {
            class: 'btn small', title: 'Do only this step\'s action now, without its waits',
            on_click: function () {
                test_step(step, panel.activity).then(function (vars) {
                    const names = Object.keys(vars);
                    const got = [];
                    for (const name of names) {
                        got.push(`{${name}} = "${String(vars[name]).slice(0, 80)}"`);
                    }
                    toast(names.length === 0 ? `${step_title(step, index)} done` : `${step_title(step, index)}: ${got.join(', ')}`);
                }, function (e) {
                    toast(e.message, { type: 'error' });
                });
            },
        }, '▶ Test this step'),
        h('button', { class: 'btn small', on_click: function () { play_activity(panel.activity, index); } }, '▶ Play from here'),
        h('span', { class: 'grow' }),
        h('button', {
            class: 'btn small danger',
            on_click: function () {
                commit(function (activity) { activity.steps.splice(index, 1); }, false);
                steps_changed();
                panel.open_step = -1;
                panel_render();
            },
        }, 'Delete step'),
        save_button(step.id)));
    return h('div', { class: 'step-body' }, sections);
}

/*
 * save_button(id) -> "💾 Save" when that step ('' = the settings) has unsaved changes,
 *   else a quiet "✓ Saved"
 */
function save_button(id) {
    const dirty = panel.activity.unsaved.indexOf(id) >= 0;
    return h('button', {
        class: dirty ? 'btn small primary' : 'btn small ghost',
        title: gist_ready() ? 'Save, and update the GitHub gist' : 'Save',
        on_click: save_now,
    }, dirty ? '💾 Save' : '✓ Saved');
}

/*
 * render_step(index) -> one step row (and its body when open)
 */
function render_step(index) {
    const step = panel.activity.steps[index];
    const open = panel.open_step === index;
    const row = h('div', { class: `step${step.enabled ? '' : ' off'}` },
        h('div', {
            class: 'step-head',
            on_click: function () {
                panel.open_step = open ? -1 : index;
                panel_render();
            },
        },
        h('span', { class: 'badge' }, String(index + 1)),
        step_has_point(step) ? mini_screen(step, true) : null,
        h('div', { class: 'what' },
            h('div', { class: 'title' }, step_title(step, index),
                panel.activity.unsaved.indexOf(step.id) >= 0 ? h('span', { class: 'unsaved', title: 'Changed since the last Save' }, 'unsaved') : null),
            h('div', { class: 'desc' }, step_summary(step))),
        h('input', {
            type: 'checkbox', checked: step.enabled, title: 'Play this step',
            on_click: function (event) { event.stopPropagation(); },
            on_change: function (event) {
                edit_step(index, function (s) { s.enabled = event.target.checked; }, true);
            },
        }),
        h('button', { class: 'btn ghost small', title: 'Move up', on_click: function (event) { event.stopPropagation(); move_step(index, -1); } }, '▲'),
        h('button', { class: 'btn ghost small', title: 'Move down', on_click: function (event) { event.stopPropagation(); move_step(index, 1); } }, '▼')),
        open ? render_step_body(index) : null);
    return row;
}

// ---------- views ----------

/*
 * render_list() -> the list of this site's activities
 */
function render_list() {
    const list = activities_for(location.href);
    const cards = [];
    for (const activity of list) {
        const a = activity;
        cards.push(h('div', { class: 'card clickable', on_click: function () { open_activity(a); } },
            h('div', { class: 'row' },
                h('h3', { class: 'grow' }, a.name),
                h('button', {
                    class: 'btn primary small', title: 'Play',
                    on_click: function (event) {
                        event.stopPropagation();
                        play_activity(a, 0);
                    },
                }, '▶')),
            h('div', { class: 'muted' }, `${a.steps.length} step${a.steps.length === 1 ? '' : 's'} · about ${format_ms(activity_duration(a))} · `
                + (a.loops === 0 ? 'loops until stopped' : `${a.loops}×`))));
    }
    if (cards.length === 0) {
        cards.push(h('div', { class: 'empty' },
            h('div', null, h('b', null, 'No activities on this site yet.')),
            h('div', null, 'An activity is a list of clicks on pixels you mark, with pauses and checks between them.')));
    }
    return [h('button', { class: 'btn primary', on_click: new_activity }, '＋ New activity'), cards];
}

/*
 * render_detail() -> one activity: settings, then its steps
 */
function render_detail() {
    const a = panel.activity;
    panel.rows = [];
    const steps = [];
    for (let i = 0; i < a.steps.length; i++) {
        const row = render_step(i);
        panel.rows.push(row);
        steps.push(row);
        if (i < a.steps.length - 1) {
            steps.push(h('div', { class: 'flow' }, `↓ ${format_ms(a.steps[i].pause_ms)}`));
        }
    }
    if (steps.length === 0) {
        steps.push(h('div', { class: 'empty' }, 'No steps yet. ', h('b', null, 'Add a click'), ' and then click the spot on the page.'));
    }
    return [
        h('div', { class: 'row' },
            h('button', { class: 'btn ghost small', on_click: close_activity }, '←'),
            text_field(a.name, function (v) {
                edit_settings(function (act) { act.name = v.trim() || 'Untitled'; }, false);
            }, { class: 'name grow', 'aria-label': 'Activity name' })),
        h('div', { class: 'row' },
            h('button', { class: 'btn primary', on_click: function () { play_activity(a, 0); } }, '▶ Play'),
            h('button', { class: 'btn', on_click: stop_run }, '■ Stop'),
            a.unsaved.length > 0
                ? h('button', { class: 'btn primary', title: 'Save every change, and update the gist', on_click: save_now }, '💾 Save')
                : h('span', { class: 'muted' }, '✓ Saved'),
            h('span', { class: 'grow' }),
            'Loops', number_field(a.loops, function (n) {
                edit_settings(function (act) { act.loops = clamp(Math.round(n), 0, 100000); }, true);
            }, { min: '0', title: '0 = until stopped' }),
            'every', seconds_field(a.loop_pause_ms, function (ms) {
                edit_settings(function (act) { act.loop_pause_ms = ms; }, false);
            }), 's'),
        h('div', { class: 'row' }, h('span', { class: 'muted' }, 'Runs on'), text_field(a.pages, function (v) {
            edit_settings(function (act) { act.pages = v.trim() || `${act.site}/*`; }, false);
        }, { class: 'grow', title: 'Pages this activity is for: a * pattern or /regex/' })),
        render_device_row(a),
        render_points_row(a),
        h('div', { class: 'row' },
            h('label', { class: 'row' }, h('input', {
                type: 'checkbox', checked: a.need_online,
                on_change: function (event) {
                    edit_settings(function (act) { act.need_online = event.target.checked; }, true);
                },
            }), 'Only play with internet'),
            a.need_online ? select_field(a.offline, { wait: 'if it\'s off, wait for it', stop: 'if it\'s off, stop' }, function (v) {
                edit_settings(function (act) { act.offline = v; }, false);
            }) : null),
        h('div', { class: 'steps' }, steps),
        h('div', { class: 'row' },
            h('button', { class: 'btn primary', on_click: function () { add_point_step('click'); } }, '＋ Add click (mark on page)'),
            h('button', { class: 'btn', title: 'Type into the field the click before this step focuses', on_click: add_type_step }, '⌨ Type text'),
            select_field('', {
                '': '＋ Other step…', read: 'Read text (mark on page)', side: 'Run on another site (split view)', wait: 'Only wait', key: 'Press a key',
            }, function (v) {
                if (v === 'read') {
                    add_point_step('read');
                } else if (v !== '') {
                    add_other_step(v);
                }
            })),
        h('div', { class: 'row', style: { marginTop: '12px' } },
            h('span', { class: 'grow' }),
            h('button', {
                class: 'btn small danger',
                on_click: function () {
                    if (!confirm(`Delete the activity "${a.name}"?${gist_ready() ? ' It is removed from the gist too (the gist\'s history still has it).' : ''}`)) {
                        return;
                    }
                    remove_activity(a.id);
                    gist_sync_soon();
                    close_activity();
                },
            }, 'Delete activity')),
    ];
}

/*
 * render_points_row(a) -> tools for all points at once: make them follow their element,
 *   or move them all by a few pixels
 */
function render_points_row(a) {
    let old = 0;
    for (const step of a.steps) {
        if (step_has_point(step) && (step.place !== 'element' || !step.anchor)) {
            old++;
        }
    }
    const dx = h('input', { type: 'number', value: '0', title: 'pixels right (negative: left)' });
    const dy = h('input', { type: 'number', value: '0', title: 'pixels down (negative: up)' });
    return [
        old === 0 ? null : h('div', { class: 'row note' },
            h('span', { class: 'grow' }, `${old} point${old === 1 ? '' : 's'} stay on a fixed pixel and break when the layout moves (pinning the side panel, resizing).`),
            h('button', {
                class: 'btn small primary',
                title: 'Do this with the page laid out the way it was when you marked them (e.g. unpinned)',
                on_click: function () {
                    let made = 0;
                    commit(function (act) {
                        for (const step of act.steps) {
                            if (!step_has_point(step) || (step.place === 'element' && step.anchor)) {
                                continue;
                            }
                            const p = point_of(step);
                            step.place = 'element';
                            set_point(step, p.x, p.y);
                            if (step.anchor) {
                                made++;
                            }
                            mark_unsaved(act, step.id);
                        }
                    }, true);
                    toast(`${made} point${made === 1 ? '' : 's'} now follow their element. The marks must sit right when you do this.`);
                },
            }, 'Make them follow')),
        h('div', { class: 'row' }, h('span', { class: 'muted' }, 'Move all points'), dx, 'px right,', dy, 'px down',
            h('button', {
                class: 'btn small',
                on_click: function () {
                    const mx = to_number(dx.value, 0);
                    const my = to_number(dy.value, 0);
                    if (mx === 0 && my === 0) {
                        return;
                    }
                    commit(function (act) {
                        for (const step of act.steps) {
                            if (step_has_point(step)) {
                                const p = point_of(step);
                                set_point(step, p.x + mx, p.y + my);
                                mark_unsaved(act, step.id);
                            }
                        }
                    }, true);
                },
            }, 'Move')),
    ];
}

/*
 * render_device_row(a) -> "View as [Mobile] [Portrait]", and a button when this tab is
 *   shown differently
 */
function render_device_row(a) {
    const same = device_matches(device_current, a.device, a.orientation);
    return h('div', { class: 'row' },
        h('span', { class: 'muted' }, 'View as'),
        select_field(a.device, DEVICES, function (v) {
            edit_settings(function (act) { act.device = v; }, true);
        }),
        a.device === 'desktop' ? null : select_field(a.orientation, ORIENTATIONS, function (v) {
            edit_settings(function (act) { act.orientation = v; }, true);
        }),
        same ? null : h('button', {
            class: 'btn small', title: 'Show this tab that way now, to mark points on that layout (the page reloads)',
            on_click: function () { switch_device(a.device, a.orientation); },
        }, 'Show it now'),
        !same || device_current.mode === 'desktop' ? null : h('span', { class: 'muted' }, '· this tab now'),
        device_supported() ? null : h('span', { class: 'muted' }, '(needs Moss 0.2+)'));
}

/*
 * render_net() — the online light in the header
 */
function render_net() {
    if (panel.net === null) {
        return;
    }
    let state = 'checking';
    if (net.online === true) {
        state = 'on';
    } else if (net.online === false) {
        state = 'off';
    }
    const words = { on: 'Online', off: 'Offline', checking: 'Checking…' };
    panel.net.className = `net ${state}`;
    panel.net.textContent = words[state];
    panel.net.title = state === 'off' ? 'No internet connection: activities that need it wait. Click to check again.' : 'Internet connection — click to check again';
}

/*
 * render_transfer() -> export / import as JSON
 */
function render_transfer() {
    const area = h('textarea', { spellcheck: 'false' }, export_activities(activities_for(location.href)));
    return [
        h('div', { class: 'row' },
            h('button', { class: 'btn ghost small', on_click: function () { panel.view = 'list'; panel_render(); } }, '←'),
            h('b', null, 'Export / import')),
        h('div', { class: 'muted' }, 'This site\'s activities as JSON. Copy it to keep or share; paste JSON here and click Import to add activities.'),
        area,
        h('div', { class: 'row' },
            h('button', {
                class: 'btn',
                on_click: function () {
                    navigator.clipboard.writeText(area.value).then(function () { toast('Copied'); });
                },
            }, 'Copy'),
            h('button', {
                class: 'btn primary',
                on_click: function () {
                    try {
                        toast(`Imported ${import_activities(area.value)} activities`);
                        gist_sync_soon();
                        panel.view = 'list';
                        panel_render();
                    } catch (e) {
                        toast(`Import failed: ${e.message}`, { type: 'error' });
                    }
                },
            }, 'Import')),
    ];
}

/*
 * ago(ms) -> "just now", "5 min ago", "3 h ago"
 */
function ago(ms) {
    const s = Math.round((Date.now() - ms) / 1000);
    if (s < 45) {
        return 'just now';
    }
    if (s < 3600) {
        return `${Math.round(s / 60)} min ago`;
    }
    if (s < 86400) {
        return `${Math.round(s / 3600)} h ago`;
    }
    return new Date(ms).toLocaleDateString();
}

/*
 * render_cloud() — the gist button in the footer: off, synced when, or failing
 */
function render_cloud() {
    if (panel.cloud === null) {
        return;
    }
    const conf = gist_conf();
    let text = '☁ Gist';
    let cls = 'btn small';
    if (gist_ready()) {
        if (conf.error !== '') {
            text = '☁ Sync failed';
            cls += ' danger';
        } else {
            text = conf.last_sync > 0 ? `☁ Synced ${ago(conf.last_sync)}` : '☁ Syncing…';
        }
    }
    panel.cloud.className = cls;
    panel.cloud.textContent = text;
    panel.cloud.title = conf.error !== '' ? conf.error : 'Back up and sync your activities in a GitHub gist';
}

/*
 * download(name, text) — save text as a file
 */
function download(name, text) {
    const link = h('a', { href: URL.createObjectURL(new Blob([text], { type: 'application/json' })), download: name });
    document.body.append(link);
    link.click();
    link.remove();
    setTimeout(function () {
        URL.revokeObjectURL(link.href);
    }, 10000);
}

/*
 * render_sync() -> the gist settings: connect, status, sync now, history, backup
 */
function render_sync() {
    const conf = gist_conf();
    const back = h('button', { class: 'btn ghost small', on_click: function () { panel.view = panel.activity === null ? 'list' : 'detail'; panel_render(); } }, '←');
    const status = h('div', { class: conf.error !== '' ? 'note bad' : 'note' });
    if (!gist_ready()) {
        status.textContent = 'Not connected.';
    } else if (conf.error !== '') {
        status.textContent = `Last sync failed: ${conf.error}`;
    } else {
        status.textContent = conf.last_sync > 0 ? `Synced ${ago(conf.last_sync)}.` : 'Not synced yet.';
    }
    const backup = h('button', {
        class: 'btn small',
        on_click: function () {
            download(`followme-backup-${new Date().toISOString().slice(0, 10)}.json`, backup_text());
        },
    }, '⬇ Download a backup file');
    if (!gist_ready()) {
        const token = h('input', { type: 'password', placeholder: 'GitHub token (ghp_… or github_pat_…)', class: 'grow', autocomplete: 'off' });
        const id = h('input', { type: 'text', placeholder: 'Gist id or URL (empty = find or make one)', class: 'grow', spellcheck: 'false' });
        const connect = h('button', {
            class: 'btn primary',
            on_click: function () {
                if (token.value.trim() === '') {
                    toast('Paste a token first.', { type: 'error' });
                    return;
                }
                connect.disabled = true;
                connect.textContent = 'Connecting…';
                gist_connect(token.value.trim(), id.value).then(function (c) {
                    toast('Connected — your activities are in the gist');
                    panel_render();
                    return c;
                }, function (e) {
                    connect.disabled = false;
                    connect.textContent = 'Connect';
                    toast(e.message, { type: 'error' });
                });
            },
        }, 'Connect');
        return [
            h('div', { class: 'row' }, back, h('b', null, '☁ GitHub gist')),
            h('div', { class: 'muted' }, 'Keeps every activity of every site in one private gist: one readable file per activity. ',
                'It is updated when you press Save, add a step, or delete or import an activity, and read when followMe starts. ',
                'The gist keeps every earlier version (Revisions), so it is also your backup history.'),
            h('ol', { class: 'muted howto' },
                h('li', null, 'On GitHub: Settings → Developer settings → Personal access tokens → ',
                    h('a', { href: 'https://github.com/settings/tokens/new?scopes=gist&description=followMe', target: '_blank', rel: 'noopener' }, 'new token (classic)'),
                    ' with only the ', h('b', null, 'gist'), ' scope.'),
                h('li', null, 'Paste it here. Leave the gist empty: followMe finds your followMe gist, or makes a new private one.'),
                h('li', null, 'On another computer, paste the same token to get the same activities.')),
            h('div', { class: 'row' }, token),
            h('div', { class: 'row' }, id),
            h('div', { class: 'row' }, connect),
            h('div', { class: 'muted' }, 'The token is kept in Moss\'s storage for this script on this computer.'),
            h('div', { class: 'row' }, backup),
        ];
    }
    return [
        h('div', { class: 'row' }, back, h('b', null, '☁ GitHub gist')),
        status,
        h('div', { class: 'row' },
            h('button', {
                class: 'btn primary',
                on_click: function () {
                    status.textContent = 'Syncing…';
                    gist_sync().then(function (r) {
                        toast(`Synced: ${r.pulled} taken from the gist, ${r.pushed} written to it`);
                        panel_render();
                    }, function (e) {
                        toast(e.message, { type: 'error' });
                        panel_render();
                    });
                },
            }, '⟳ Sync now'),
            conf.url ? h('a', { class: 'btn', href: conf.url, target: '_blank', rel: 'noopener' }, 'Open the gist') : null,
            conf.url ? h('a', { class: 'btn', href: `${conf.url}/revisions`, target: '_blank', rel: 'noopener', title: 'Every earlier version: your backups' }, 'History') : null),
        h('label', { class: 'row' }, h('input', {
            type: 'checkbox', checked: conf.auto,
            on_change: function (event) {
                gist_conf_set({ auto: event.target.checked });
            },
        }), 'Sync automatically (Save, add a step, start-up)'),
        h('div', { class: 'muted' }, `Gist ${conf.gist_id}`),
        h('div', { class: 'row' }, backup,
            h('button', {
                class: 'btn small danger',
                on_click: function () {
                    if (confirm('Stop syncing with this gist? The gist stays on GitHub; the activities stay here.')) {
                        gist_disconnect();
                        panel_render();
                    }
                },
            }, 'Disconnect')),
    ];
}

/*
 * panel_render() — draw the panel for the current view
 */
function panel_render() {
    if (!panel_visible()) {
        return;
    }
    if (panel.layer === null) {
        panel.layer = layer_create('panel', PANEL_CSS);
        if (panel.side !== null) {
            panel.side.set_root(panel.layer.root);
        }
    }
    // In the side panel the copy is what shows; the page keeps it out of sight.
    panel.layer.host.style.display = panel.side_shown || panel.hidden ? 'none' : '';
    // Redrawing replaces the body: keep where it was scrolled to (same view only).
    const old_body = panel.layer.root.querySelector('.body');
    const keep_scroll = old_body !== null && old_body.dataset.view === panel.view ? old_body.scrollTop : 0;
    if (panel.view === 'detail' && panel.activity !== null) {
        panel.activity = load_activity(panel.activity.id);
        if (panel.activity === null) {
            panel.view = 'list';
        }
    }
    let body = null;
    if (panel.view === 'detail') {
        body = render_detail();
    } else if (panel.view === 'transfer') {
        body = render_transfer();
    } else if (panel.view === 'sync') {
        body = render_sync();
    } else {
        body = render_list();
    }
    panel.net = h('button', {
        class: 'net',
        on_click: function () {
            panel.net.className = 'net checking';
            panel.net.textContent = 'Checking…';
            check_online(true).then(render_net);
        },
    });
    panel.cloud = h('button', { class: 'btn small', on_click: function () { panel.view = 'sync'; panel_render(); } });
    panel.status = h('div', { class: 'status', hidden: true }, h('span', { class: 'text' }), h('button', { class: 'btn small', on_click: stop_run }, '■ Stop'));
    const side = panel.prefs.side;
    const root = h('div', { class: `fm panel ${side}${panel.side_shown ? ' in-side' : ''}` },
        h('div', { class: 'head' },
            h('span', { class: 'logo' }, 'follow', h('b', null, 'Me')),
            h('span', { class: 'site grow' }, location.hostname),
            panel.net,
            panel.side_shown
                ? h('button', { class: 'btn small', title: 'Put the panel back on the page', on_click: unpin }, 'Unpin')
                : [
                    h('button', { class: 'btn ghost small', title: 'Pin to Chrome\'s side panel: next to the page instead of over it, full size in phone view', on_click: pin }, '📌'),
                    h('button', {
                        class: 'btn ghost small', title: 'Move to the other side',
                        on_click: function () {
                            panel.prefs.side = side === 'right' ? 'left' : 'right';
                            save_prefs(panel.prefs);
                            panel_render();
                            tab_render();
                        },
                    }, '⇆'),
                    h('button', { class: 'btn ghost small', title: 'Close (Alt+Shift+P)', on_click: panel_close }, '✕'),
                ]),
        h('div', { class: 'body', 'data-view': panel.view }, body),
        panel.status,
        h('div', { class: 'foot' },
            h('label', { class: 'row' }, h('input', {
                type: 'checkbox', checked: panel.prefs.show_marks,
                on_change: function (event) {
                    panel.prefs.show_marks = event.target.checked;
                    save_prefs(panel.prefs);
                    show_marks();
                },
            }), 'Show marks'),
            h('span', { class: 'grow' }),
            panel.cloud,
            h('button', { class: 'btn small', on_click: function () { panel.view = 'transfer'; panel_render(); } }, 'Export / import')));
    panel.layer.root.replaceChildren(h('style', null, BASE_CSS + PANEL_CSS), root);
    root.querySelector('.body').scrollTop = keep_scroll;
    render_net();
    render_cloud();
    show_marks();
    if (current_run !== null) {
        render_status(current_run);
    }
}

/*
 * render_status(run) — the status bar and the playing step, without redrawing the panel
 */
function render_status(run) {
    const playing = ['before', 'action', 'after', 'pause'].indexOf(run.phase) >= 0 && !run.stopped;
    if (panel.status !== null) {
        panel.status.hidden = false;
        panel.status.className = `status ${run.phase}`;
        const left = run.left_ms > 0 ? ` · ${format_ms(run.left_ms)}` : '';
        const loop = run.activity.loops === 1 ? '' : ` [loop ${run.loop + 1}${run.activity.loops === 0 ? '' : `/${run.activity.loops}`}]`;
        panel.status.firstChild.textContent = `${playing ? '▶ ' : ''}${run.text}${left}${loop}`;
        panel.status.lastChild.hidden = !playing;
    }
    const same = panel.view === 'detail' && panel.activity !== null && panel.activity.id === run.activity.id;
    for (let i = 0; i < panel.rows.length; i++) {
        panel.rows[i].classList.toggle('current', same && playing && i === run.step);
    }
    if (playing) {
        if (!same || !panel_visible()) {
            marks_set(run.activity, -1, null);
        }
        marks_active(run.step);
    } else {
        marks_active(-1);
        show_marks();
    }
    tab_render();
}

// ---------- the edge tab ----------

let tab_layer = null;

/*
 * tab_render() — the small tab on the window's edge that opens the panel
 */
function tab_render() {
    if (panel_visible()) {
        if (tab_layer !== null) {
            layer_remove(tab_layer);
            tab_layer = null;
        }
        return;
    }
    if (tab_layer === null) {
        tab_layer = layer_create('tab', TAB_CSS);
    }
    const side = panel.prefs.side;
    tab_layer.root.replaceChildren(h('style', null, BASE_CSS + TAB_CSS), h('div', { class: 'fm' },
        h('button', {
            class: `tab ${side}${is_running() ? ' running' : ''}`,
            title: is_running() ? 'followMe is playing — click to open (Esc stops)' : 'followMe (Alt+Shift+P)',
            style: { top: `calc(${clamp(panel.prefs.tab_y, 0, 1) * 100}% - 32px)` },
            on_click: panel_toggle,
        }, 'followMe')));
}

// ---------- src/main.js ----------

/*
 * Starting followMe on a page: the edge tab, the panel if it was left open, the
 * Alt+Shift+P shortcut, Esc to stop a run, the menu command, keeping the panel in step
 * with other tabs, watching the internet connection, carrying on a run that a page
 * load interrupted, and playing an activity another tab opened this page for.
 */

/*
 * on_key(event) — Alt+Shift+P opens / closes the panel; Esc stops a playing run
 */
function on_key(event) {
    if (event.altKey && event.shiftKey && !event.ctrlKey && !event.metaKey && event.code === 'KeyP') {
        event.preventDefault();
        panel_toggle();
        return;
    }
    if (event.key === 'Escape' && is_running()) {
        stop_run();
        toast('followMe stopped');
    }
}

/*
 * main() — start followMe on this page
 */
async function main() {
    panel.prefs = load_prefs();
    on_run_change(render_status);
    on_online_change(render_net);
    on_gist_change(render_cloud);
    watch_network();
    watch_focus();
    check_online(true);
    await device_now();
    document.addEventListener('keydown', on_key, true);
    GM_registerMenuCommand('followMe: open / close the panel', panel_toggle);
    GM_registerMenuCommand('followMe: stop playing', stop_run);
    GM_addValueChangeListener(ACTIVITIES_KEY, function (key, old_value, new_value, remote) {
        if (remote && panel_visible()) {
            panel_render(); // changed in another tab
        }
    });
    const last = panel.prefs.last_activity ? load_activity(panel.prefs.last_activity) : null;
    if (last !== null && activity_runs_on(last, location.href)) {
        panel.activity = last;
        panel.view = 'detail';
    }
    if (panel.prefs.pinned) {
        side_start();
    }
    tab_render();
    if (panel.prefs.open) {
        panel_render();
    }
    gist_sync_on_start().then(function (r) {
        if (r !== null && r.pulled > 0 && panel_visible()) {
            panel_render(); // the gist had newer activities
        }
    });
    let ran = await resume_saved_run();
    if (ran === null) {
        ran = await start_job();
    }
    if (ran !== null && ran.error !== '') {
        toast(ran.error, { type: 'error' });
    }
}

main();
